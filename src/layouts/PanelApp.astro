---
// Layout del área de socios: app a pantalla completa, sin la Nav ni el pie de la
// web pública ni la cortina de carga. Nunca se indexa.
const { title = 'Área de socios' } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title} | Start UC3M</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Permanent+Marker&family=Titillium+Web:wght@400;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
    <style is:global>
      html, body { margin: 0; background: #f8f8fc; }
      @media (prefers-color-scheme: dark) { html, body { background: #0e0e26; } }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
