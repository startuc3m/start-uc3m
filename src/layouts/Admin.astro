---
// Layout del panel /admin: sidebar + topbar. Todo el estado vive en localStorage (ver lib/admin/store.ts).
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { buildSeed } from '../lib/admin/seed';
const { title = 'Panel', section = '' } = Astro.props;
const seed = await buildSeed();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nav = [
  ['Inicio', '/admin', 'dashboard'], ['Páginas', '/admin/paginas', 'paginas'], ['Blog', '/admin/posts', 'posts'], ['Eventos', '/admin/eventos', 'eventos'],
  ['Podcast', '/admin/podcast', 'podcast'], ['Equipo', '/admin/equipo', 'equipo'], ['Patrocinadores', '/admin/patrocinadores', 'patrocinadores'],
  ['Recursos', '/admin/recursos', 'recursos'], ['Links', '/admin/links', 'links'], ['Envíos', '/admin/envios', 'envios'], ['Media', '/admin/media', 'media'], ['Ajustes', '/admin/ajustes', 'ajustes'],
];
---
<!doctype html>
<html lang="es" data-base={base}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex" />
    <title>{title} · Panel Start UC3M</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@400;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline define:vars={{ base }}>
      // Puerta de demo: sin sesión → login (excepto la propia página de login)
      try { if (location.search.indexOf('demo=1') > -1) sessionStorage.setItem('cms:session', '1'); if (sessionStorage.getItem('cms:session') !== '1' && !location.pathname.replace(base, '').match(/^\/admin\/?$/)) location.replace(base + '/admin'); } catch (e) {}
    </script>
  </head>
  <body class="bg-paper-2 text-ink">
    <script type="application/json" id="cms-seed" set:html={JSON.stringify(seed)} />
    <script is:inline define:vars={{ base }}>
      // Con base (GitHub Pages) los enlaces raíz "/x" pasan a "/WebStartUC3M/x": al cargar y en cada clic (enlaces generados por JS incluidos).
      if (base) {
        var fix = function (el) { var k = el.tagName === 'FORM' ? 'action' : 'href'; var v = el.getAttribute(k); if (v && v.charAt(0) === '/' && v.indexOf(base + '/') !== 0 && v !== base) el.setAttribute(k, base + v); };
        document.querySelectorAll('a[href^="/"], form[action^="/"]').forEach(fix);
        document.addEventListener('click', function (e) { var a = e.target && e.target.closest ? e.target.closest('a[href^="/"]') : null; if (a) fix(a); }, true);
        document.addEventListener('submit', function (e) { var f = e.target; if (f && f.tagName === 'FORM') fix(f); }, true);
      }
    </script>
    <script>
      import '../lib/admin/store';
    </script>
    <div class="flex min-h-screen">
      <aside class="hidden w-60 shrink-0 flex-col border-r border-line bg-paper md:flex">
        <div class="flex h-14 items-center gap-2 border-b border-line px-5"><Logo tone="cobalt" size={20} /><span class="mono text-cobalt">panel</span></div>
        <nav class="flex flex-1 flex-col gap-0.5 p-3">
          {nav.map(([l, h, k]) => <a href={h} class={`adm-nav ${section === k ? 'adm-nav-active' : ''}`}>{l}</a>)}
        </nav>
        <div class="border-t border-line p-3"><a href="/" class="adm-nav">← Ver la web</a><button class="adm-nav w-full text-left" onclick="cms.logout()">Salir</button></div>
      </aside>
      <div class="flex min-w-0 flex-1 flex-col">
        <header class="flex h-14 items-center justify-between border-b border-line bg-paper px-5">
          <div class="flex items-center gap-3"><a href="/admin" class="md:hidden"><Logo tone="cobalt" size={18} /></a><h1 class="text-base font-bold">{title}</h1></div>
          <div class="flex items-center gap-3"><span class="mono hidden text-cobalt sm:inline">● local · sin publicar</span><button class="adm-btn" data-publish>Publicar</button><span class="grid h-8 w-8 place-items-center rounded-full bg-cobalt text-xs font-bold text-white">IN</span></div>
        </header>
        <main class="flex-1 p-5 md:p-8"><slot /></main>
      </div>
    </div>
    <script>
      document.querySelector('[data-publish]')?.addEventListener('click', () => {
        const b = document.querySelector<HTMLButtonElement>('[data-publish]')!; b.textContent = 'Publicando…'; b.disabled = true;
        setTimeout(() => { b.textContent = 'Publicar'; b.disabled = false; window.cms.toast('Cambios publicados en startuc3m.es'); const s = document.querySelector('.mono.text-cobalt'); if (s) s.textContent = '● publicado hace un momento'; }, 900);
      });
    </script>
  </body>
</html>
