---
import { asset } from '../lib/url';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/site';
const { title, description = site.description, tone = 'light', image } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fullTitle = title ? `${title} | Start UC3M` : 'Start UC3M | Asociación de emprendedores de la UC3M';
const siteOrigin = Astro.site?.origin ?? 'https://www.startuc3m.es';
const ogImage = image ? (image.startsWith('http') ? image : `${siteOrigin}${base}${image}`) : `${siteOrigin}${base}/brand/logo-full-cobalt.png`;
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: siteOrigin,
  logo: `${siteOrigin}${base}/favicon.svg`,
  email: site.email,
  sameAs: Object.values(site.social),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Cortina solo la primera vez por sesión (y nunca con ?noloader). Se retira sola a los 1,6 s.
      (function () {
        var skip = location.search.indexOf('noloader') > -1;
        try { skip = skip || sessionStorage.getItem('start-loaded') === '1'; sessionStorage.setItem('start-loaded', '1'); } catch (e) {}
        var h = document.documentElement;
        if (skip) h.classList.add('no-loader'); else { h.classList.add('is-loading'); setTimeout(function () { var l = document.querySelector('.loader'); if (l) l.remove(); h.classList.remove('is-loading'); }, 1700); }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2b3a91" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Start UC3M" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600;700;900&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="loader" aria-hidden="true"><img src={asset("/brand/logo-full-white.png")} alt="" width="816" height="342" /><div class="loader-bar"></div></div>
    <Nav tone={tone} />
    <main><slot /></main>
    <Footer />
    <script is:inline define:vars={{ base }}>
      // Con base (GitHub Pages) los enlaces raíz "/x" pasan a "/WebStartUC3M/x": al cargar y en cada clic (enlaces generados por JS incluidos).
      if (base) {
        var fix = function (el) { var k = el.tagName === 'FORM' ? 'action' : 'href'; var v = el.getAttribute(k); if (v && v.charAt(0) === '/' && v.indexOf(base + '/') !== 0 && v !== base) el.setAttribute(k, base + v); };
        document.querySelectorAll('a[href^="/"], form[action^="/"]').forEach(fix);
        document.addEventListener('click', function (e) { var a = e.target && e.target.closest ? e.target.closest('a[href^="/"]') : null; if (a) fix(a); }, true);
        document.addEventListener('submit', function (e) { var f = e.target; if (f && f.tagName === 'FORM') fix(f); }, true);
      }
    </script>
    <script is:inline>
      // CMS local: textos editados en /admin (localStorage cms:site) se muestran en la web
      try { var st = JSON.parse(localStorage.getItem('cms:site') || 'null'); if (st) document.querySelectorAll('[data-cms^="site."]').forEach(function (el) { var k = el.getAttribute('data-cms').slice(5); if (st[k]) { el.textContent = st[k] + (el.getAttribute('data-cms-suffix') || ''); if (el.tagName === 'A' && k === 'email') el.setAttribute('href', 'mailto:' + st[k]); } }); } catch (e) {}
    </script>
    <script>
      import { initLoader, initMotion } from '../lib/motion';
      initLoader().then(initMotion);
    </script>
  </body>
</html>
