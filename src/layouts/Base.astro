---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StartcampBar from '../components/StartcampBar.astro';
import StartcampBanner from '../components/StartcampBanner.astro';
import { site } from '../lib/site';
const { title, description = site.description, tone = 'light', image, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | Start UC3M` : 'Start UC3M | Asociación de emprendedores de la UC3M';
const siteOrigin = Astro.site?.origin ?? 'https://www.startuc3m.es';
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const ogImage = image ? (image.startsWith('http') ? image : `${siteOrigin}${image}`) : `${siteOrigin}/brand/logo-full-cobalt.png`;
const organizationJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: siteOrigin,
  logo: `${siteOrigin}/favicon.svg`,
  email: site.email,
  sameAs: Object.values(site.social),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Cortina solo la primera vez por sesión (y nunca con ?noloader). Se retira sola a los 1,6 s.
      (function () {
        var skip = location.search.indexOf('noloader') > -1;
        try { skip = skip || sessionStorage.getItem('start-loaded') === '1'; sessionStorage.setItem('start-loaded', '1'); } catch (e) {}
        var h = document.documentElement;
        if (skip) h.classList.add('no-loader'); else { h.classList.add('is-loading'); setTimeout(function () { var l = document.querySelector('.loader'); if (l) l.remove(); h.classList.remove('is-loading'); }, 1700); }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#333399" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Start UC3M" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Permanent+Marker&family=Titillium+Web:wght@300;400;600;700;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div class="loader" aria-hidden="true"><img src="/brand/logo-full-white.png" alt="" width="816" height="342" /><div class="loader-bar"></div></div>
    <StartcampBanner />
    <Nav tone={tone} />
    <main><slot /></main>
    <Footer />
    <StartcampBar />
    <script>
      import { initLoader, initMotion } from '../lib/motion';
      initLoader().then(initMotion);
    </script>
  </body>
</html>
