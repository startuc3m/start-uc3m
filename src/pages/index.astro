---
import Photo from '../components/Photo.astro';
import { eventoFotos } from '../lib/fotos';
import Base from '../layouts/Base.astro';
import PodcastTrack from '../components/PodcastTrack.astro';
import SponsorTicker from '../components/SponsorTicker.astro';
import { eventos as publicados, posts as postsPublicados, blogVisible } from '../lib/content';
import { site } from '../lib/site';
import ContactForm from '../components/ContactForm.astro';
import Doodle from '../components/Doodle.astro';
import HistoriaVideo from '../components/HistoriaVideo.astro';
import Momentos from '../components/Momentos.astro';
import StartcampLanyard from '../components/lanyard/startcamp-lanyard';
const eventos = await publicados();
const next = eventos.find((e) => e.data.status !== 'pasado');
const conBlog = await blogVisible();
const posts = (await postsPublicados()).slice(0, 3);
const fmtLong = (d: Date) => d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
const fmtShort = (d: Date) => d.toLocaleDateString('es-ES', { day: '2-digit', month: 'short' }).toUpperCase();
---
<Base tone="dark">
  <StartcampLanyard client:only="react" anchorX="calc(100% - 260px)" scale={1.4} showHint={false} />
  <!-- HERO: la sala llena del Start Camp, fundida con el azul de Start -->
  <section class="relative overflow-hidden bg-cobalt text-white">
    <Photo name="start-camp-sala-llena" eager class="absolute inset-0 h-full w-full object-cover object-[center_30%] opacity-80 mix-blend-luminosity" />
    <div class="absolute inset-0 bg-gradient-to-b from-cobalt/20 via-cobalt/55 to-cobalt"></div>
    <div class="container-x relative flex flex-col justify-center pb-12 pt-12 md:pb-16 md:pt-16 lg:min-h-[800px]">
      <!-- A partir de lg la columna derecha queda libre para el lanyard del Start Camp -->
      <div class="lg:pr-[380px]">
        <p class="marker -rotate-2 text-[clamp(20px,2.2vw,30px)] text-lime">Stop talking, Start walking</p>
        <h1 class="display relative mt-3 text-[clamp(56px,8vw,128px)]">
          Somos gente <span class="hl hl-lime">haciendo cosas</span>_
          <Doodle name="star" class="absolute -top-12 right-0 hidden w-[clamp(56px,6vw,96px)] rotate-12 md:block lg:-right-6" />
        </h1>
        <p class="mt-8 max-w-xl text-xl leading-snug text-lavender md:text-2xl">La asociación de emprendedores de la Universidad Carlos III de Madrid. Proyectos, eventos, empresas, cañas y viajes: ideas que empiezan como una conversación y acaban siendo algo real.</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/socios#alta" class="btn btn-lime">Hazte socio <span class="font-mono">→</span></a>
          <a href="/eventos" class="btn btn-outline text-white">Ver eventos</a>
          <a href="/patrocina" class="btn btn-outline text-white">Soy una empresa</a>
        </div>
        <div class="mt-10 flex flex-wrap gap-6 md:gap-10">
          {[['', '2013', 'Desde', 2013], ['', '8', 'Departamentos', 8], ['+', '3.000', 'Estudiantes', 3000]].map(([pre, n, l, c]) => (
            <div class="border-l-2 border-white/40 pl-4">
              <div class="display text-5xl md:text-6xl">{pre && <span class="text-lime">{pre}</span>}<span data-count={c}>{n}</span></div>
              <div class="eyebrow mt-1 text-lavender/80">{l}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <SponsorTicker />

  <!-- EVENTOS: próximo con imagen + tarjetas con imagen -->
  <section class="bg-navy text-white">
    <div class="container-x py-14 md:py-20">
      {next && <a href={`/eventos/${next.id}`} class="group grid gap-0 overflow-hidden rounded-brand bg-cobalt md:grid-cols-[1.1fr_1fr]" data-reveal>
        <div class="relative aspect-[4/3] md:aspect-auto md:min-h-[480px]" data-img-reveal>
          <Photo class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" name={eventoFotos[next.id]?.card} sizes="(min-width: 768px) 55vw, 100vw" alt={next.data.title} />
          <span class="eyebrow absolute left-4 top-4 rounded-full bg-navy/70 px-3 py-2 text-lavender backdrop-blur">Próximo evento</span>
        </div>
        <div class="flex flex-col justify-between gap-8 p-8 md:p-12">
          <div>
            <span class="eyebrow text-lavender">{next.data.type} · {fmtLong(next.data.date)} · {next.data.time}</span>
            <h2 class="display mt-4 text-[clamp(36px,4.5vw,64px)]">{next.data.title}</h2>
            <p class="mt-4 text-lg text-lavender">{next.data.subtitle}. {next.data.place}.</p>
            <ul class="mt-5 flex flex-wrap gap-2">{next.data.tags.slice(0, 3).map((t) => <li class="mono rounded-full border border-white/40 px-3 py-1.5">{t}</li>)}</ul>
          </div>
          <div class="flex items-center justify-between">
            <span class="btn btn-lime">{next.data.external ? 'Reservar plaza' : 'Ver el evento'} <span class="font-mono">→</span></span>
            {next.data.seats && <span class="mono text-lavender">{next.data.seats} plazas</span>}
          </div>
        </div>
      </a>}

      <div class={`${next ? 'mt-10 ' : ''}flex justify-center`} data-reveal><a href="/eventos" class="btn btn-outline text-white">Ver todos los eventos <span class="font-mono">→</span></a></div>
    </div>
  </section>

  <!-- QUIÉNES SOMOS: pilares + hitos + foto -->
  <section class="bg-paper text-ink">
    <div class="container-x py-16 md:py-20">
      <div class="grid gap-10 md:gap-16 md:grid-cols-[1fr_1.4fr]" data-reveal>
        <div>
          <span class="eyebrow text-cobalt">¿Quiénes somos?</span>
          <h2 class="display mt-4 text-[clamp(40px,5vw,72px)] text-cobalt">Todo esto lo hacen <span class="hl">estudiantes</span>_</h2>
          <p class="mt-6 max-w-md text-lg leading-relaxed">Start UC3M nació en 2013, cuando seis alumnos de ADE vieron que en la Carlos III faltaba algo que juntara a gente técnica, de diseño y de negocio. Hoy organizamos eventos con fundadores, inversores y marcas, y detrás de cada uno hay un equipo de estudiantes de la UC3M.</p>
          <a href="/equipo" class="btn btn-primary mt-8">Conoce al equipo <span class="font-mono">→</span></a>
        </div>
        <div class="grid gap-6 sm:grid-cols-3" data-stagger>
          {site.pillars.map((p, i) => (
            <div class="border-t-2 border-cobalt pt-5"><span class="eyebrow text-cobalt">0{i + 1}</span><h3 class="mt-2 text-2xl font-bold">{p.title}</h3><p class="mt-2 text-sm leading-relaxed opacity-80">{p.desc}</p></div>
          ))}
        </div>
      </div>
      <div class="mt-12 md:mt-20 grid gap-8 md:gap-12 md:grid-cols-[1fr_1fr] md:items-center">
        <div class="relative" data-reveal>
          <p class="marker mb-3 flex items-end gap-2 text-2xl text-cobalt">Así empezó todo <Doodle name="arrow" class="h-12 w-12 translate-y-4 rotate-[25deg]" /></p>
          <HistoriaVideo class="aspect-video" />
        </div>
        <ol class="border-t border-line" data-stagger>
          {site.milestones.map((m) => (
            <li class="grid grid-cols-[80px_1fr] gap-6 border-b border-line py-5"><span class="display text-3xl text-cobalt">{m.year}</span><div><h3 class="text-xl font-bold">{m.title}</h3><p class="mt-1 text-sm opacity-80">{m.desc}</p></div></li>
          ))}
        </ol>
      </div>
      <ul class="mt-10 md:mt-16 grid border-t border-line sm:grid-cols-2 lg:grid-cols-4" data-stagger>
        {site.departments.map((d) => (
          <li class="flex items-baseline gap-3 border-b border-line py-4 pr-6"><span class="text-lg font-bold text-cobalt">{d.name}</span><span class="text-sm opacity-70">{d.short}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <Momentos />

  <PodcastTrack />

  <!-- STARTER -->
  <section class="bg-paper text-ink">
    <div class="container-x grid gap-8 md:gap-12 py-16 md:py-20 md:grid-cols-[1fr_1.2fr] md:items-end" data-reveal>
      <div class="relative aspect-[4/5] overflow-hidden rounded-brand">
        <Photo class="absolute inset-0 h-[120%] w-full object-cover" name="starters-pizarra" sizes="(min-width: 768px) 45vw, 100vw" alt="Starters de Start UC3M delante de la pizarra con el logo de Start" />
      </div>
      <div>
        <span class="eyebrow text-cobalt">¿Qué es un starter?</span>
        <h2 class="display mt-4 text-[clamp(36px,5vw,72px)] text-cobalt">Un starter no es solo alguien que forma parte de Start_</h2>
        <p class="mt-6 max-w-xl text-lg leading-relaxed">Es una persona con iniciativa, curiosidad y ganas reales de implicarse. Alguien que aporta ideas, energía y actitud a la comunidad, y que entiende que el valor de Start lo construimos entre todos.</p>
        <a href="/unete" class="btn btn-primary mt-8">Quiero entrar en Start <span class="font-mono">→</span></a>
      </div>
    </div>
  </section>

  <!-- BLOG -->
  {conBlog && (
  <section class="bg-paper-2 text-ink">
    <div class="container-x py-14 md:py-20" data-reveal>
      <div class="flex items-end justify-between">
        <div><span class="eyebrow text-cobalt">Blog</span><h2 class="display mt-3 text-[clamp(32px,4vw,56px)]">Lo último de la comunidad</h2></div>
        <a href="/blog" class="btn btn-outline hidden md:inline-flex">Ver todos los posts</a>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3" data-stagger>
        {posts.map((p, i) => (
          <a href={`/blog/${p.id}`} class="group">
            <div class="relative aspect-[16/10] overflow-hidden rounded-brand bg-cobalt"><Photo class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" /></div>
            <span class="eyebrow mt-4 block text-cobalt">{p.data.category} · {p.data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}</span>
            <h3 class="mt-2 text-2xl font-bold leading-tight group-hover:underline">{p.data.title}</h3>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- PATROCINA -->
  <section class="bg-cobalt text-white">
    <div class="container-x grid gap-10 md:gap-16 py-16 md:py-20 md:grid-cols-[1.3fr_1fr] md:items-center" data-reveal>
      <div>
        <span class="eyebrow text-lavender">Para empresas</span>
        <h2 class="display mt-4 text-[clamp(40px,6vw,88px)]">Este año puedes estar del otro lado_</h2>
        <p class="mt-6 max-w-xl text-lg text-lavender">Sé partner fijo de Start o patrocina un evento y llega a más de 3.000 estudiantes de la UC3M que quieren construir. Media kit, formatos y cifras en una página.</p>
        <a href="/patrocina" class="btn btn-on-blue mt-8">Ver media kit <span class="font-mono">→</span></a>
      </div>
      <ul class="border-t border-white/30">
        {site.tiers.map((t) => (
          <li class="flex items-center justify-between gap-6 border-b border-white/30 py-5"><span><span class="block text-2xl font-bold">{t.name}</span><span class="eyebrow text-lavender/70">{t.tag}</span></span><span class="max-w-[220px] text-right text-sm text-lavender">{t.desc}</span></li>
        ))}
      </ul>
    </div>
  </section>
  <!-- CTA FINAL + FORMULARIO -->
  <section class="bg-paper text-ink">
    <div class="container-x grid gap-8 md:gap-12 py-16 md:py-20 md:grid-cols-[1fr_1.2fr]">
      <div data-reveal>
        <span class="eyebrow text-cobalt">Hablemos</span>
        <h2 class="display mt-4 text-[clamp(40px,6vw,88px)] text-cobalt">¿Construimos algo juntos?</h2>
        <p class="mt-6 max-w-md text-lg leading-relaxed">Tengas una idea, una startup o una empresa que quiera estar cerca del talento de la UC3M: escríbenos y te respondemos lo antes posible.</p>
        <ul class="mt-8 flex flex-col gap-3" data-stagger>
          {[['Quiero entrar en Start', '/unete'], ['Quiero venir a un evento', '/eventos'], ['Quiero patrocinar', '/patrocina']].map(([l, h]) => (
            <li><a href={h} class="group flex items-center justify-between border-b border-line py-3 text-xl font-bold hover:text-cobalt">{l}<span class="font-mono text-cobalt transition-transform group-hover:translate-x-1">→</span></a></li>
          ))}
        </ul>
        <p class="mono mt-8 text-cobalt">O directo: <a class="underline" href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
      <div class="rounded-brand bg-cobalt p-8 text-white md:p-12" data-reveal>
        <span class="eyebrow text-lavender">Contacto</span>
        <h3 class="display mt-3 text-[clamp(28px,3.5vw,44px)]">Escríbenos_</h3>
        <div class="mt-6">
          <ContactForm dark />
        </div>
      </div>
    </div>
  </section>
</Base>
