---
import Admin from '../../layouts/Admin.astro';
import fs from 'node:fs';
import path from 'node:path';

type MediaItem = { path: string; folder: string; name: string; size: number };
const ROOT = path.resolve('public');
const FOLDERS: [string, string][] = [
  ['media', 'General'],
  ['media/equipo', 'Equipo'],
  ['media/blog', 'Blog'],
  ['logos', 'Logos'],
  ['brand', 'Marca'],
];
const IMG = /\.(jpe?g|png|webp|svg|gif)$/i;
const items: MediaItem[] = [];
for (const [dir, label] of FOLDERS) {
  const abs = path.join(ROOT, dir);
  if (!fs.existsSync(abs)) continue;
  for (const f of fs.readdirSync(abs).sort()) {
    const full = path.join(abs, f);
    if (!IMG.test(f) || !fs.statSync(full).isFile()) continue;
    items.push({ path: `/${dir}/${f}`, folder: label, name: f, size: fs.statSync(full).size });
  }
}
const folders = FOLDERS.map(([, l]) => l);
---
<Admin title="Media" section="media">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="display text-3xl">Biblioteca de medios_</h2>
      <p class="mt-1 text-sm text-ink/60">Imágenes del sitio: fotos, equipo, blog, logos y marca. <span class="mono" id="count"></span></p>
    </div>
    <div class="flex items-center gap-2">
      <input id="file" type="file" accept="image/*" multiple class="hidden" />
      <button class="adm-btn" id="upload">+ Subir</button>
    </div>
  </div>

  <div class="mt-6 flex flex-wrap items-center gap-2">
    <div class="flex flex-wrap gap-2" id="chips">
      <button class="adm-badge adm-badge-ok" data-chip="">Todas</button>
      {folders.map((f) => <button class="adm-badge hover:border-cobalt" data-chip={f}>{f}</button>)}
    </div>
    <input id="q" class="adm-input ml-auto w-full sm:w-64" placeholder="Buscar por nombre…" />
  </div>

  <div class="mt-5 flex gap-5">
    <div class="min-w-0 flex-1">
      <div id="grid" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5"></div>
      <p id="empty" class="adm-card mt-4 hidden text-center text-sm text-ink/60">No hay imágenes que coincidan con la búsqueda.</p>
    </div>

    <aside id="panel" class="adm-card hidden w-80 shrink-0 self-start lg:sticky lg:top-6"></aside>
  </div>

  <script type="application/json" id="media-data" set:html={JSON.stringify(items)}></script>
  <script>
    type Item = { path: string; folder: string; name: string; size: number; local?: boolean };
    const cms = window.cms;
    const base = document.documentElement.dataset.base || '';
    const src = (p: string) => (p.startsWith('http') || p.startsWith('blob:') ? p : base + p);
    const fmtSize = (n: number) => (n >= 1024 * 1024 ? (n / 1024 / 1024).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB');

    let items: Item[] = JSON.parse(document.getElementById('media-data')!.textContent || '[]');
    let folder = '';
    let q = '';
    let selected: string | null = null;

    const grid = document.getElementById('grid')!;
    const empty = document.getElementById('empty')!;
    const panel = document.getElementById('panel')!;
    const count = document.getElementById('count')!;

    function filtered() {
      const t = q.trim().toLowerCase();
      return items.filter((i) => (!folder || i.folder === folder) && (!t || i.name.toLowerCase().includes(t) || i.path.toLowerCase().includes(t)));
    }

    function render() {
      const list = filtered();
      count.textContent = `${list.length} de ${items.length}`;
      empty.classList.toggle('hidden', list.length > 0);
      grid.innerHTML = list
        .map(
          (i) => `
        <button data-sel="${cms.esc(i.path)}" class="group overflow-hidden rounded-brand border ${selected === i.path ? 'border-cobalt ring-2 ring-cobalt/30' : 'border-line'} bg-white text-left hover:border-cobalt">
          <div class="aspect-square bg-paper-2"><img src="${cms.esc(src(i.path))}" alt="" loading="lazy" class="h-full w-full object-cover" /></div>
          <div class="p-2">
            <p class="truncate text-xs font-semibold" title="${cms.esc(i.name)}">${cms.esc(i.name)}</p>
            <p class="mono mt-0.5 flex items-center gap-1 text-[10px] text-ink/50">${cms.esc(i.folder)}${i.local ? ' · <span class="text-cobalt">pendiente</span>' : ''}</p>
          </div>
        </button>`,
        )
        .join('');
      renderPanel();
    }

    function renderPanel() {
      const i = items.find((x) => x.path === selected);
      if (!i) { panel.classList.add('hidden'); panel.innerHTML = ''; return; }
      panel.classList.remove('hidden');
      panel.innerHTML = `
        <div class="flex items-start justify-between gap-2">
          <span class="adm-label">Detalle</span>
          <button class="mono text-ink/50 hover:text-cobalt" data-close>✕ cerrar</button>
        </div>
        <div class="mt-3 grid place-items-center overflow-hidden rounded-brand border border-line bg-paper-2">
          <img src="${cms.esc(src(i.path))}" alt="" class="max-h-64 w-full object-contain" />
        </div>
        <p class="mt-3 break-all text-sm font-semibold">${cms.esc(i.name)}</p>
        <p class="mono mt-1 text-ink/50">${cms.esc(i.folder)} · ${fmtSize(i.size)}${i.local ? ' · <span class="text-cobalt">pendiente de sincronizar</span>' : ''}</p>
        <label class="mt-4 block"><span class="adm-label">Ruta</span>
          <div class="flex gap-2">
            <input class="adm-input flex-1 font-mono text-xs" readonly value="${cms.esc(i.path)}" />
            <button class="adm-btn-ghost shrink-0 px-3" data-copy title="Copiar ruta">Copiar</button>
          </div>
        </label>
        <label class="mt-3 block"><span class="adm-label">Usar en…</span>
          <select class="adm-input" data-use>
            <option value="">Elegir destino</option>
            <option>Portada de un post</option>
            <option>Imagen de un evento</option>
            <option>Foto de equipo</option>
            <option>Logo de patrocinador</option>
            <option>Banner de la home</option>
          </select>
        </label>
        <div class="mt-5 flex items-center justify-between gap-2 border-t border-line pt-4">
          <a class="adm-btn-ghost" href="${cms.esc(src(i.path))}" target="_blank" rel="noopener">Abrir</a>
          <button class="adm-btn-danger" data-del>Borrar</button>
        </div>`;
    }

    grid.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-sel]');
      if (!b) return;
      selected = b.dataset.sel!;
      render();
    });

    panel.addEventListener('click', async (e) => {
      const t = e.target as HTMLElement;
      const i = items.find((x) => x.path === selected);
      if (!i) return;
      if (t.closest('[data-close]')) { selected = null; render(); return; }
      if (t.closest('[data-copy]')) {
        try { await navigator.clipboard.writeText(i.path); cms.toast('Ruta copiada'); }
        catch { cms.toast('No se pudo copiar', 'err'); }
        return;
      }
      if (t.closest('[data-del]')) {
        if (!confirm(`¿Borrar "${i.name}"? (solo en esta sesión)`)) return;
        items = items.filter((x) => x.path !== i.path);
        if (i.local) URL.revokeObjectURL(i.path);
        selected = null;
        cms.toast('Imagen borrada');
        render();
      }
    });

    panel.addEventListener('change', (e) => {
      const s = (e.target as HTMLElement).closest<HTMLSelectElement>('[data-use]');
      if (!s || !s.value) return;
      const i = items.find((x) => x.path === selected);
      cms.toast(`"${i?.name}" seleccionada para: ${s.value}`);
      s.value = '';
    });

    document.getElementById('chips')!.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-chip]');
      if (!b) return;
      folder = b.dataset.chip || '';
      document.querySelectorAll<HTMLElement>('[data-chip]').forEach((c) => c.classList.toggle('adm-badge-ok', c === b));
      render();
    });

    document.getElementById('q')!.addEventListener('input', (e) => { q = (e.target as HTMLInputElement).value; render(); });

    const file = document.getElementById('file') as HTMLInputElement;
    document.getElementById('upload')!.addEventListener('click', () => file.click());
    file.addEventListener('change', () => {
      const files = Array.from(file.files || []);
      if (!files.length) return;
      const label = folder || 'General';
      for (const f of files) {
        const url = URL.createObjectURL(f);
        items.unshift({ path: url, folder: label, name: f.name, size: f.size, local: true });
        selected = url;
      }
      file.value = '';
      cms.toast(`Subido · pendiente de sincronizar (${files.length})`);
      render();
    });

    render();
  </script>
</Admin>
