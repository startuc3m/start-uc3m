---
import Admin from '../../layouts/Admin.astro';
---
<Admin title="Links (bio)" section="links">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <h2 class="display text-3xl">Links de la bio_</h2>
      <p class="mt-1 text-sm text-ink/60">Los enlaces que aparecen en <span class="mono">/links</span> (Instagram, TikTok). Ordena, activa o destaca uno y guarda.</p>
    </div>
    <div class="flex gap-2">
      <button class="adm-btn-ghost" data-copy>Copiar URL de la bio</button>
      <button class="adm-btn" data-save>Guardar</button>
    </div>
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_360px]">
    <section class="adm-card">
      <div class="flex items-center justify-between">
        <span class="adm-label">Enlaces</span>
        <button class="adm-btn-ghost" data-add>+ Añadir link</button>
      </div>
      <div class="mt-3 hidden grid-cols-[18px_1fr_1fr_70px_60px_90px_40px] gap-2 px-2 text-xs text-ink/50 md:grid" aria-hidden="true">
        <span></span><span>Etiqueta</span><span>Enlace</span><span class="text-center">Destacado</span><span class="text-center">Activo</span><span></span><span></span>
      </div>
      <div id="rows" class="mt-2 flex flex-col gap-2"></div>
      <p id="empty" class="mono mt-6 hidden text-center text-ink/50">Aún no hay links. Añade el primero.</p>
      <p class="mono mt-4 text-ink/50">Los cambios se aplican a la vista previa al instante y se guardan con «Guardar».</p>
    </section>

    <aside class="flex flex-col gap-4">
      <div class="adm-card">
        <span class="adm-label">Vista previa</span>
        <div class="mx-auto mt-3 w-[280px] rounded-[38px] border-[6px] border-navy bg-navy p-1 shadow-xl">
          <div class="relative h-[540px] overflow-hidden rounded-[30px] bg-cobalt text-white">
            <div class="absolute inset-x-0 top-0 z-10 mx-auto mt-2 h-5 w-24 rounded-full bg-navy"></div>
            <div class="h-full overflow-y-auto px-4 pb-6 pt-12">
              <p class="display text-center text-3xl">start_</p>
              <p class="mono mt-3 text-center text-[10px] text-lavender">Inscripciones abiertas</p>
              <ul id="preview" class="mt-5 flex flex-col gap-2.5"></ul>
              <p id="preview-empty" class="mono mt-6 hidden text-center text-[10px] text-lavender/70">Sin links activos</p>
              <div class="mt-8 flex justify-center gap-4 text-[10px] font-semibold"><span>instagram</span><span>linkedin</span><span>tiktok</span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="adm-card">
        <div class="flex items-baseline justify-between"><span class="adm-label">Clicks · 7 días</span><span class="mono text-ink/50" id="stats-total"></span></div>
        <ul id="stats" class="mt-3 flex flex-col gap-2 text-sm"></ul>
      </div>
    </aside>
  </div>

  <script>
    const cms = window.cms;
    const COL = 'links';
    type Link = { id: string; label: string; href: string; featured: boolean; active: boolean; order: number };
    let items: Link[] = (cms.list(COL) as Link[]).map((l, i) => ({ ...l, featured: !!l.featured, active: l.active !== false, order: i }));
    let removed: string[] = [];

    const $ = (s: string) => document.querySelector(s) as HTMLElement;
    const rows = $('#rows'), preview = $('#preview'), stats = $('#stats');

    // Clicks "aleatorios" pero estables por id (hash sencillo)
    const clicks = (id: string) => { let h = 7; for (const c of id) h = (h * 31 + c.charCodeAt(0)) >>> 0; return 40 + (h % 900); };

    function render() {
      rows.innerHTML = items.map((l, i) => `
        <div class="grid grid-cols-[18px_1fr] gap-2 rounded-brand border border-line bg-paper px-2 py-2 md:grid-cols-[18px_1fr_1fr_70px_60px_90px_40px] md:items-center" data-i="${i}">
          <span class="mono self-center text-ink/40">${i + 1}</span>
          <input class="adm-input" data-f="label" value="${cms.esc(l.label)}" placeholder="Etiqueta" />
          <input class="adm-input col-start-2 md:col-start-auto" data-f="href" value="${cms.esc(l.href)}" placeholder="/ruta o https://…" />
          <label class="col-start-2 flex items-center gap-1 text-xs md:col-start-auto md:justify-center"><input type="radio" name="featured" data-f="featured" ${l.featured ? 'checked' : ''} /> <span class="md:hidden">Destacado</span></label>
          <label class="col-start-2 flex items-center gap-1 text-xs md:col-start-auto md:justify-center"><input type="checkbox" data-f="active" ${l.active ? 'checked' : ''} /> <span class="md:hidden">Activo</span></label>
          <div class="col-start-2 flex gap-1 md:col-start-auto">
            <button class="adm-btn-ghost px-2 py-1" data-move="-1" title="Subir" ${i === 0 ? 'disabled' : ''}>↑</button>
            <button class="adm-btn-ghost px-2 py-1" data-move="1" title="Bajar" ${i === items.length - 1 ? 'disabled' : ''}>↓</button>
          </div>
          <button class="adm-btn-danger col-start-2 px-2 py-1 md:col-start-auto" data-del title="Borrar">✕</button>
        </div>`).join('');
      $('#empty').classList.toggle('hidden', items.length > 0);
      renderPreview();
    }

    function renderPreview() {
      const active = items.filter((l) => l.active && l.label.trim());
      preview.innerHTML = active.map((l) => `<li><span class="flex items-center justify-between rounded-brand px-3.5 py-2.5 text-[13px] font-semibold ${l.featured ? 'bg-white text-cobalt' : 'border border-white/50'}">${cms.esc(l.label)}<span class="font-mono">→</span></span></li>`).join('');
      $('#preview-empty').classList.toggle('hidden', active.length > 0);
      const max = Math.max(1, ...items.map((l) => clicks(l.id)));
      const total = items.reduce((a, l) => a + (l.active ? clicks(l.id) : 0), 0);
      $('#stats-total').textContent = `${total} en total`;
      stats.innerHTML = items.map((l) => `<li class="${l.active ? '' : 'opacity-40'}"><div class="flex justify-between gap-2"><span class="truncate">${cms.esc(l.label || '(sin etiqueta)')}</span><span class="mono shrink-0">${clicks(l.id)}</span></div><div class="mt-1 h-1.5 rounded-full bg-paper-2"><div class="h-full rounded-full bg-cobalt" style="width:${Math.round((clicks(l.id) / max) * 100)}%"></div></div></li>`).join('') || '<li class="mono text-ink/50">Sin datos.</li>';
    }

    // Edición inline: cualquier cambio actualiza el modelo y la preview
    rows.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement; const i = +(t.closest('[data-i]') as HTMLElement).dataset.i!; const f = t.dataset.f;
      if (f === 'label' || f === 'href') items[i][f] = t.value;
      else if (f === 'active') items[i].active = t.checked;
      else if (f === 'featured') items.forEach((l, j) => (l.featured = j === i));
      renderPreview();
    });
    rows.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button') as HTMLButtonElement | null; if (!b) return;
      const i = +(b.closest('[data-i]') as HTMLElement).dataset.i!;
      if (b.dataset.move) { const j = i + +b.dataset.move; if (j < 0 || j >= items.length) return; [items[i], items[j]] = [items[j], items[i]]; render(); }
      else if (b.hasAttribute('data-del')) { if (!confirm(`¿Borrar «${items[i].label || 'link'}»?`)) return; removed.push(items[i].id); items.splice(i, 1); render(); }
    });
    $('[data-add]').addEventListener('click', () => {
      items.push({ id: cms.uid(), label: '', href: '/', featured: false, active: true, order: items.length }); render();
      (rows.lastElementChild?.querySelector('[data-f="label"]') as HTMLInputElement)?.focus();
    });

    $('[data-save]').addEventListener('click', () => {
      if (items.some((l) => !l.label.trim() || !l.href.trim())) return cms.toast('Todos los links necesitan etiqueta y enlace', 'err');
      removed.forEach((id) => cms.remove(COL, id)); removed = [];
      items.forEach((l, i) => cms.save(COL, { ...l, order: i }));
      cms.reorder(COL, items.map((l) => l.id));
      cms.toast('Guardado');
      items = (cms.list(COL) as Link[]).map((l, i) => ({ ...l, order: i })); render();
    });

    $('[data-copy]').addEventListener('click', async () => {
      const url = `${location.origin}${document.documentElement.dataset.base || ''}/links`;
      try { await navigator.clipboard.writeText(url); cms.toast(`Copiado: ${url}`); } catch { prompt('Copia la URL:', url); }
    });

    render();
  </script>
</Admin>
