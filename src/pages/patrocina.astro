---
import { asset } from '../lib/url';
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import { site } from '../lib/site';
const stats = [['3.000', 'Estudiantes alcanzados por curso', 3000], ['3.000', 'Seguidores en Instagram', 2990], ['12', 'Eventos al año', 12], ['13', 'Años construyendo', 13]];
const offers = [
  ['01', 'Talento', 'Acceso directo a starters y asistentes: prácticas, cofundadores y primeras contrataciones. La gente que va a construir, antes de que esté en LinkedIn.'],
  ['02', 'Marca en campus', 'Tu marca en todos los eventos del curso, en la cartelería de Puerta de Toledo y en las redes de Start: Instagram, TikTok, LinkedIn y YouTube.'],
  ['03', 'Contenido', 'Un episodio de StartTheWeek con tu equipo, grabado en el campus, y crónicas de tus eventos en el blog y la newsletter de Start.'],
  ['04', 'Datos', 'Feedback directo en el propio evento: de qué grado son y qué les interesó de tu propuesta, cara a cara. No cedemos bases de datos de asistentes.'],
];
const contentThumb = 'https://img.youtube.com/vi/G2hVH1AGr38/hqdefault.jpg';
const photos = [
  ['/media/madrid-night.jpg', 'Buildathon', 'Arranque de curso · 60 personas construyendo en una tarde'],
  ['/media/leganes-biblioteca-1.jpg', 'StartXperience', 'Un día con startups, inversores e incubadoras · 300 personas'],
  ['/media/equipo/clemente_cebrian.jpeg', 'Start Camp', 'Dos días de trabajo en equipo, mentores y demos · sold out'],
];
// Sin citas reales todavía — Partnerships tiene que conseguirlas de NomuLabs/Pitchless antes de publicar nada atribuido.
const testimonials: { quote: string; who: string; logo: string }[] = [];
const partner = site.tiers[0];
const others = site.tiers.slice(1);
---
<Base title="Patrocina Start" description="Media kit de Start UC3M: cifras, tiers y qué obtiene tu empresa al patrocinar la asociación de emprendedores de la UC3M." tone="dark">
  <!-- HERO: cobalto sólido, sin foto (distinto de la home); cursor _ gigante y rejilla sutil -->
  <section class="relative overflow-hidden bg-cobalt text-white">
    <div class="pointer-events-none absolute inset-0 opacity-[0.07]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 96px 96px;" aria-hidden="true"></div>
    <span class="display pointer-events-none absolute -bottom-24 right-4 select-none text-[clamp(240px,40vw,640px)] leading-none text-white/10 md:right-16" data-parallax="10" aria-hidden="true">_</span>
    <div class="container-x relative flex min-h-[80vh] flex-col justify-end pb-20 pt-24">
      <span class="eyebrow text-lavender">Media kit · Para empresas</span>
      <h1 class="display mt-4 max-w-5xl text-[clamp(48px,9vw,140px)]" data-split>Este año puedes estar del otro lado_</h1>
      <p class="mt-8 max-w-2xl text-xl text-lavender">Start UC3M es la puerta de entrada al talento emprendedor de la Universidad Carlos III. Patrocinar Start es estar delante de la gente que va a fundar, construir y contratar en los próximos cinco años.</p>
      <div class="mt-10 flex flex-wrap gap-3"><a href="#contacto" class="btn btn-on-blue">Hablar con Partnerships <span class="font-mono">→</span></a><a href="/dossier-startuc3m.pdf" class="btn btn-outline text-white">Descargar dossier PDF</a></div>
    </div>
  </section>

  <!-- YA CONFÍAN: muro de logos grande -->
  <section class="border-b border-line bg-paper text-ink">
    <div class="container-x py-20">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div><span class="eyebrow text-cobalt">Ya confían en Start</span><h2 class="display mt-3 text-[clamp(32px,4.5vw,64px)] text-cobalt">Empresas que ya están dentro_</h2></div>
        <a href="/patrocinadores" class="mono text-cobalt hover:underline">Ver todos los patrocinadores →</a>
      </div>
      <ul class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4" data-stagger>
        {site.sponsors.map((s) => (
          <li class="grid aspect-[3/1.6] place-items-center rounded-brand border border-line bg-white p-8 transition-transform hover:-translate-y-1" data-reveal>
            {s.logo ? <img src={asset(s.logo)} alt={s.name} class="max-h-16 w-auto max-w-full object-contain" loading="lazy" /> : <span class="text-2xl font-bold uppercase tracking-wider text-cobalt">{s.name}</span>}
          </li>
        ))}
      </ul>
      <p class="mono mt-8 text-ink/60" data-reveal>En prensa · EFE Emprende: "una organización estudiantil que pretende acercar la innovación, el emprendimiento y el inconformismo a otros jóvenes"</p>
    </div>
  </section>

  <!-- CIFRAS -->
  <section class="border-b border-line bg-paper"><div class="container-x grid gap-8 py-16 sm:grid-cols-2 md:grid-cols-4" data-stagger>
    {stats.map(([n, l, c]) => <div data-reveal><div class="display text-6xl text-cobalt md:text-7xl" data-count={c}>{n}</div><div class="eyebrow mt-2 opacity-70">{l}</div></div>)}
  </div></section>

  <!-- POR QUÉ START -->
  <section class="container-x grid gap-16 py-24 md:grid-cols-[1fr_1.3fr]">
    <div data-reveal><span class="eyebrow text-cobalt">Por qué Start</span><h2 class="display mt-4 text-[clamp(32px,4.5vw,64px)] text-cobalt" data-split>Talento antes de que esté en LinkedIn.</h2></div>
    <ul class="grid gap-8 sm:grid-cols-2" data-stagger>
      {[['Audiencia cualificada', 'Estudiantes de ADE, ingenierías, derecho y diseño que ya han decidido que quieren construir algo.'], ['Eventos con marca', 'Buildathon, StartXperience y Start Camp con tu naming, tu producto y tu gente dentro.'], ['Bolsa de talento', 'Contacto en persona con starters y asistentes en cada evento: sin base de datos exportable.'], ['Presencia todo el curso', 'Web, links en bio, newsletter, redes (IG, TikTok, LinkedIn, YouTube) y campus.']].map(([h, d]) => (
        <li class="border-t-2 border-cobalt pt-5" data-reveal><h3 class="text-2xl font-bold">{h}</h3><p class="mt-2 opacity-80">{d}</p></li>
      ))}
    </ul>
  </section>

  <!-- LO QUE OFRECEMOS: editorial con imagen -->
  <section class="bg-paper-2 text-ink"><div class="container-x grid gap-12 py-24 md:grid-cols-[1fr_1.2fr] md:items-center">
    <div class="relative aspect-[4/5] overflow-hidden rounded-brand" data-reveal>
      <img src={asset('/media/leganes-auditorio-1.jpg')} alt="Auditorio de la UC3M" class="absolute inset-0 h-[120%] w-full object-cover" data-parallax="8" loading="lazy" />
      <span class="eyebrow absolute bottom-4 left-4 rounded-full bg-navy/70 px-3 py-2 text-lavender backdrop-blur">UC3M · Auditorio</span>
    </div>
    <div>
      <div data-reveal><span class="eyebrow text-cobalt">Lo que ofrecemos</span><h2 class="display mt-3 text-[clamp(32px,4.5vw,64px)] text-cobalt" data-split>Más que un logo en un cartel_</h2></div>
      <ul class="mt-10 border-t border-line" data-stagger>
        {offers.map(([n, t, d]) => (
          <li class="grid grid-cols-[48px_1fr] gap-4 border-b border-line py-6" data-reveal>
            <span class="mono pt-2 text-cobalt">{n}</span>
            <div>
              <h3 class="text-2xl font-bold">{t}</h3><p class="mt-2 text-sm leading-relaxed opacity-80">{d}</p>
              {t === 'Contenido' && <a href="/podcast" class="mt-3 inline-flex items-center gap-3 rounded-brand border border-line bg-white p-2 pr-4 transition-transform hover:-translate-y-0.5"><img src={contentThumb} alt="StartTheWeek" class="h-12 w-20 rounded-[2px] object-cover" loading="lazy" /><span class="mono text-cobalt">StartTheWeek ▶</span></a>}
            </div>
          </li>
        ))}
      </ul>
      <a href="#contacto" class="btn btn-primary mt-8">Hablar con Partnerships <span class="font-mono">→</span></a>
    </div>
  </div></section>

  <!-- FOTOS DE EVENTOS -->
  <section class="bg-paper text-ink"><div class="container-x py-20">
    <span class="eyebrow text-cobalt" data-reveal>Así se ve por dentro</span>
    <ul class="mt-6 grid gap-6 md:grid-cols-3" data-stagger>
      {photos.map(([src, t, d]) => (
        <li class="group" data-reveal>
          <div class="relative aspect-[4/3] overflow-hidden rounded-brand bg-cobalt"><img src={asset(src)} alt={t} class="absolute inset-0 h-[120%] w-full object-cover transition-transform duration-700 group-hover:scale-105" data-parallax="8" loading="lazy" /></div>
          <h3 class="mt-4 text-2xl font-bold">{t}</h3><p class="mt-1 text-sm opacity-70">{d}</p>
        </li>
      ))}
    </ul>
  </div></section>

  <!-- TIERS: partner fijo editorial + dos filas -->
  <section class="bg-navy text-white"><div class="container-x py-24">
    <div data-reveal>
      <span class="eyebrow text-lavender">Formatos</span>
      <h2 class="display mt-3 text-[clamp(32px,5vw,72px)]" data-split>Partner fijo o por evento_</h2>
      <p class="mt-4 max-w-xl text-lavender">Un partner fijo está dentro de Start todo el curso; el patrocinio de evento es puntual. Se pueden combinar.</p>
    </div>

    <div class="relative mt-12 grid gap-0 overflow-hidden rounded-brand border-2 border-white bg-cobalt md:grid-cols-[1fr_1.2fr]" data-reveal>
      <span class="mono absolute right-6 top-6 z-10 rounded-full bg-white px-3 py-1 text-cobalt">Recomendado</span>
      <div class="relative aspect-[4/3] md:aspect-auto md:min-h-[460px]">
        <img src={asset('/media/leganes-auditorio-2.jpg')} alt="" class="absolute inset-0 h-full w-full object-cover opacity-90" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-cobalt via-transparent to-transparent md:bg-gradient-to-r"></div>
      </div>
      <div class="flex flex-col p-8 md:p-12">
        <span class="eyebrow text-lavender">{partner.tag}</span>
        <h3 class="display mt-3 text-[clamp(40px,5vw,72px)]">{partner.name}</h3>
        <p class="mt-4 text-lg text-lavender">{partner.desc}</p>
        <ul class="mt-6 grid gap-2 border-t border-white/20 pt-6 sm:grid-cols-2" data-stagger>{partner.perks.map((p) => <li class="flex gap-2" data-reveal><span class="font-mono text-lavender">_</span>{p}</li>)}</ul>
        <a href="#contacto" class="btn btn-on-blue mt-8 self-start">Quiero ser partner <span class="font-mono">→</span></a>
      </div>
    </div>

    <ul class="mt-6 grid gap-6 md:grid-cols-2" data-stagger>
      {others.map((t) => (
        <li class="flex flex-col rounded-brand border border-cobalt p-8 md:flex-row md:items-start md:gap-8" data-reveal>
          <div class="md:w-1/2">
            <span class="eyebrow text-lavender">{t.tag}</span>
            <h3 class="mt-2 text-3xl font-bold">{t.name}</h3>
            <p class="mt-2 text-sm text-lavender">{t.desc}</p>
            <a href="#contacto" class="mono mt-4 inline-block text-lavender hover:text-white">Me interesa →</a>
          </div>
          <ul class="mt-6 flex flex-col gap-2 border-t border-white/20 pt-6 text-sm md:mt-0 md:w-1/2 md:border-l md:border-t-0 md:pl-8 md:pt-0">{t.perks.map((p) => <li class="flex gap-2"><span class="font-mono text-lavender">_</span>{p}</li>)}</ul>
        </li>
      ))}
    </ul>
    <p class="eyebrow mt-8 text-lavender/70">Condiciones a medida · adaptamos cada colaboración</p>
  </div></section>

  <!-- TESTIMONIOS: sección oculta hasta que Partnerships tenga citas reales -->
  {testimonials.length > 0 && (
    <section class="bg-paper text-ink"><div class="container-x py-24">
      <span class="eyebrow text-cobalt" data-reveal>Lo que dicen los partners</span>
      <ul class="mt-8 grid gap-8 md:grid-cols-2" data-stagger>
        {testimonials.map((t) => (
          <li class="flex flex-col justify-between rounded-brand border border-line bg-white p-8 md:p-10" data-reveal>
            <p class="text-2xl font-semibold leading-snug text-cobalt md:text-3xl">{t.quote}</p>
            <div class="mt-8 flex items-center justify-between border-t border-line pt-6">
              <span class="mono opacity-70">{t.who}</span>
              <img src={asset(t.logo)} alt="" class="max-h-10 w-auto object-contain" loading="lazy" />
            </div>
          </li>
        ))}
      </ul>
    </div></section>
  )}

  <!-- EVENTOS PATROCINABLES -->
  <section class="container-x py-24" data-reveal>
    <span class="eyebrow text-cobalt">Eventos patrocinables</span>
    <ul class="mt-6 border-t border-line" data-stagger>
      {[['Buildathon', 'Septiembre · 60 personas · arranque de curso', 'Evento'], ['StartXperience', 'Abril · 300 personas · inversores e incubadoras', 'Partner / Evento'], ['Start Camp', 'Noviembre · 40 personas · 2 días', 'Evento'], ['StartTheWeek (podcast)', 'Todo el curso · YouTube y Spotify', 'Partner']].map(([n, d, t]) => (
        <li class="grid gap-2 border-b border-line py-6 md:grid-cols-[1fr_1.5fr_auto] md:items-center" data-reveal><span class="text-3xl font-bold">{n}</span><span class="opacity-70">{d}</span><span class="eyebrow text-cobalt">{t}</span></li>
      ))}
    </ul>
  </section>

  <!-- CONTACTO -->
  <section id="contacto" class="bg-cobalt text-white"><div class="container-x grid gap-12 py-24 md:grid-cols-[1fr_1.4fr]">
    <div data-reveal><span class="eyebrow text-lavender">Contacto empresas</span><h2 class="display mt-3 text-[clamp(32px,5vw,72px)]" data-split>Hablemos_</h2><p class="mt-4 text-lavender">Partnerships te responde en menos de 48 h. También en <a class="underline" href={`mailto:${site.email}`}>{site.email}</a>.</p></div>
    <Form name="patrocinio" dark submit="Enviar" fields={[
      { name: 'empresa', label: 'Empresa', required: true },
      { name: 'nombre', label: 'Persona de contacto', required: true },
      { name: 'email', label: 'Email', type: 'email', required: true },
      { name: 'interes', label: 'Interés', type: 'select', options: ['Partner fijo', 'Patrocinio de un evento', 'Colaborador (en especie)', 'Aún no lo sé'] },
      { name: 'mensaje', label: 'Mensaje', type: 'textarea', full: true, placeholder: 'Cuéntanos qué buscáis' },
    ]} />
  </div></section>
</Base>
