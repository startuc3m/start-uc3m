// Comparte estilos con /privacidad (src/socios/Privacidad.css) para que las dos páginas legales se vean igual.
// Sin banner de cookies: vale mientras la analítica no use cookies (Vercel Web Analytics no las usa).
import Base from '../layouts/Base.astro';
import '../socios/Privacidad.css';
---
<Base title="Aviso legal" description="Titular de la web de Start UC3M y condiciones de uso." tone="dark">
  <header class="privacidad__hero">
    <div class="privacidad__hero-dentro">
      <span class="eyebrow privacidad__eyebrow">Legal</span>
      <h1 class="display privacidad__titulo">Aviso legal_</h1>
      <p class="privacidad__fecha">Última actualización: 20 de noviembre de 2026</p>
    </div>
  </header>

  <div class="privacidad">
    <section>
      <h2>1. Titular de la web</h2>
      <p>
        En cumplimiento del artículo 10 de la Ley 34/2002, de Servicios de la Sociedad de la Información y de
        Comercio Electrónico (LSSI-CE), se informa de que esta web es titularidad de:
      </p>
      <ul>
        <li><strong>Denominación:</strong> Asociación de Emprendedores UC3M («Start UC3M»)</li>
        <li><strong>NIF:</strong> G86907300</li>
        <li><strong>Domicilio social:</strong> Calle Madrid, 126, despacho 6.0.01, 28903 Getafe (Madrid)</li>
        <li><strong>Correo electrónico:</strong> <a href="mailto:startuc3m@gmail.com">startuc3m@gmail.com</a></li>
        <li><strong>Registro:</strong> inscrita en el Registro de Asociaciones de la Comunidad de Madrid con el número 34194</li>
      </ul>
