---
import { asset } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../lib/site';
const depts = ['Todos', ...site.departments.map((d) => d.name)];
---
<Base title="Equipo" tone="dark">
  <PageHead eyebrow="Equipo" title="Conoce a quien está detrás_" intro="Una asociación sin equipo no es nada. Detrás de Start UC3M hay un grupo de personas con ganas de cambiar las cosas." />
  <section class="container-x py-16">
    <div class="flex flex-wrap gap-2" role="tablist">
      {depts.map((d, i) => <button data-filter={d} class={`eyebrow rounded-full border px-3 py-2 ${i === 0 ? 'bg-cobalt text-white border-cobalt' : 'border-line'}`}>{d}</button>)}
    </div>
    <p data-dept-desc class="mt-8 max-w-2xl text-lg opacity-80"></p>
    <ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 md:grid-cols-4" data-stagger>
      {site.team.map((m) => (
        <li data-dept={m.dept} data-reveal>
          {m.linkedin ? (
            <a href={m.linkedin} target="_blank" rel="noopener" class="group block" aria-label={`${m.name} en LinkedIn`}>
              <div class="relative aspect-[4/5] overflow-hidden rounded-brand bg-cobalt">
                {m.photo ? <img src={asset(m.photo)} alt={m.name} class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" /> : <span class="display absolute inset-0 grid place-items-center text-6xl text-white/80">{m.name.split(" ").map((w) => w[0]).slice(0, 2).join("")}</span>}
                <span class="mono absolute bottom-3 left-3 rounded-full bg-white px-3 py-1 text-cobalt opacity-0 transition-opacity group-hover:opacity-100">LinkedIn ↗</span>
              </div>
              <h2 class="mt-4 text-xl font-bold group-hover:underline">{m.name}</h2>
              <p class="text-sm opacity-70">{m.role} · {m.dept}</p>
            </a>
          ) : (
            <div>
              <div class="relative aspect-[4/5] overflow-hidden rounded-brand bg-cobalt">{m.photo ? <img src={asset(m.photo)} alt={m.name} class="absolute inset-0 h-full w-full object-cover" loading="lazy" /> : <span class="display absolute inset-0 grid place-items-center text-6xl text-white/80">{m.name.split(" ").map((w) => w[0]).slice(0, 2).join("")}</span>}</div>
              <h2 class="mt-4 text-xl font-bold">{m.name}</h2>
              <p class="text-sm opacity-70">{m.role} · {m.dept}</p>
            </div>
          )}
        </li>
      ))}
    </ul>
    <div class="mt-24 rounded-brand bg-paper-2 p-10 md:p-16">
      <span class="eyebrow text-cobalt">Viejas glorias</span>
      <h2 class="display mt-3 text-[clamp(32px,4vw,56px)] text-cobalt">Alumni de Start_</h2>
      {site.alumni.length > 0 ? (
        <ul class="mt-10 grid gap-x-8 gap-y-12 sm:grid-cols-2 md:grid-cols-4" data-stagger>
          {site.alumni.map((a) => (
            <li data-reveal>
              <div class="aspect-[4/5] rounded-brand bg-cobalt"></div>
              <h3 class="mt-4 text-xl font-bold">{a.name}</h3>
              <p class="text-sm opacity-70">{a.role}</p>
              {a.linkedin && <a href={a.linkedin} class="eyebrow mt-2 inline-block text-cobalt">LinkedIn</a>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 max-w-xl text-lg">Desde 2013 han pasado por Start decenas de starters que hoy fundan, invierten o trabajan en startups. Pronto, aquí.</p>
      )}
    </div>
  </section>
</Base>
<script define:vars={{ departments: site.departments }}>
  const buttons = document.querySelectorAll('[data-filter]');
  const items = document.querySelectorAll('[data-dept]');
  const desc = document.querySelector('[data-dept-desc]');
  const apply = (d) => {
    buttons.forEach((b) => b.classList.toggle('bg-cobalt', b.dataset.filter === d) || b.classList.toggle('text-white', b.dataset.filter === d) || b.classList.toggle('border-cobalt', b.dataset.filter === d));
    items.forEach((it) => (it.style.display = d === 'Todos' || it.dataset.dept === d ? '' : 'none'));
    desc.textContent = departments.find((x) => x.name === d)?.desc ?? '';
    history.replaceState(null, '', d === 'Todos' ? location.pathname : `?dept=${encodeURIComponent(d)}`);
  };
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter)));
  const q = new URLSearchParams(location.search).get('dept'); if (q) apply(q);
</script>
