---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../lib/site';
// `photo` en site.team es el nombre del archivo en src/assets/equipo.
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/equipo/*', { eager: true });
const foto = (f: string) => {
  const img = fotos[`../assets/equipo/${f}`];
  if (!img) throw new Error(`Falta la foto src/assets/equipo/${f}`);
  return img.default;
};
const depts = ['Todos', ...site.departments.map((d) => d.name)];
const initials = (n: string) => n.split(' ').map((w) => w[0]).slice(0, 2).join('');
// El filtro de Junta directiva incluye a los responsables de cada departamento, como en la web anterior.
const filterKeys = (m: (typeof site.team)[number]) => [...m.depts, ...(m.role === 'Responsable' ? ['Junta directiva'] : [])].join('|');
---
<Base title="Equipo" tone="dark">
  <PageHead eyebrow="Equipo" title="Conoce a quien está detrás_" intro="Una asociación sin equipo no es nada. Detrás de Start UC3M hay un grupo de personas con ganas de cambiar las cosas." />
  <section class="container-x py-10 md:py-16">
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar por departamento">
      {depts.map((d, i) => <button type="button" data-filter={d} aria-pressed={String(i === 0)} class={`eyebrow rounded-full border px-3 py-2 ${i === 0 ? 'bg-cobalt text-white border-cobalt' : 'border-line'}`}>{d}</button>)}
    </div>
    <p data-dept-desc class="mt-8 max-w-2xl text-lg opacity-80"></p>
    <ul class="mt-10 grid gap-x-8 gap-y-8 md:gap-y-12 sm:grid-cols-2 md:grid-cols-4" data-stagger>
      {site.team.map((m) => (
        <li data-dept={filterKeys(m)} data-reveal>
          {m.linkedin ? (
            <a href={m.linkedin} target="_blank" rel="noopener" class="group block" aria-label={`${m.name} en LinkedIn`}>
              <div class="relative aspect-[4/5] overflow-hidden rounded-brand bg-cobalt">
                {m.photo ? <Image src={foto(m.photo)} alt={m.name} width={480} class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" /> : <span class="display absolute inset-0 grid place-items-center text-6xl text-white/80">{initials(m.name)}</span>}
                <span class="mono absolute bottom-3 left-3 rounded-full bg-white px-3 py-1 text-cobalt opacity-0 transition-opacity group-hover:opacity-100">LinkedIn ↗</span>
              </div>
              <h2 class="mt-4 text-xl font-bold group-hover:underline">{m.name}</h2>
              <p class="text-sm opacity-80">{m.role} · {m.depts.join(' y ')}</p>
            </a>
          ) : (
            <div>
              <div class="relative aspect-[4/5] overflow-hidden rounded-brand bg-cobalt">{m.photo ? <Image src={foto(m.photo)} alt={m.name} width={480} class="absolute inset-0 h-full w-full object-cover" /> : <span class="display absolute inset-0 grid place-items-center text-6xl text-white/80">{initials(m.name)}</span>}</div>
              <h2 class="mt-4 text-xl font-bold">{m.name}</h2>
              <p class="text-sm opacity-80">{m.role} · {m.depts.join(' y ')}</p>
            </div>
          )}
        </li>
      ))}
    </ul>
    {site.alumni.length > 0 && (
      <div class="mt-14 md:mt-24 rounded-brand bg-paper-2 p-10 md:p-16">
        <span class="eyebrow text-cobalt">Viejas glorias</span>
        <h2 class="display mt-3 text-[clamp(32px,4vw,56px)] text-cobalt">Alumni de Start_</h2>
        <ul class="mt-10 grid gap-x-8 gap-y-8 md:gap-y-12 sm:grid-cols-2 md:grid-cols-4" data-stagger>
          {site.alumni.map((a) => (
            <li data-reveal>
              <h3 class="text-xl font-bold">{a.name}</h3>
              <p class="text-sm opacity-80">{a.role}</p>
              {a.linkedin && <a href={a.linkedin} class="eyebrow mt-2 inline-block text-cobalt">LinkedIn</a>}
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Base>
<script define:vars={{ departments: site.departments }}>
  const buttons = document.querySelectorAll('[data-filter]');
  const items = document.querySelectorAll('[data-dept]');
  const desc = document.querySelector('[data-dept-desc]');
  const apply = (d) => {
    buttons.forEach((b) => {
      const on = b.dataset.filter === d;
      ['bg-cobalt', 'text-white', 'border-cobalt'].forEach((c) => b.classList.toggle(c, on));
      b.classList.toggle('border-line', !on);
      b.setAttribute('aria-pressed', String(on));
    });
    items.forEach((it) => (it.style.display = d === 'Todos' || it.dataset.dept.split('|').includes(d) ? '' : 'none'));
    desc.textContent = departments.find((x) => x.name === d)?.desc ?? '';
    history.replaceState(null, '', d === 'Todos' ? location.pathname : `?dept=${encodeURIComponent(d)}`);
  };
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter)));
  const q = new URLSearchParams(location.search).get('dept'); if (q) apply(q);
</script>
