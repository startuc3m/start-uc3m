---
import Base from '../../../layouts/Base.astro';
import { getStartSkills, estados, programa, fechaCorta, fechaLarga, rangoMeses, introPrograma, asociacionesDelPrograma, tono } from '../../../lib/startskills';
const { bloques } = getStartSkills();
const est = estados(bloques);
const chip = {
  celebrado: { t: 'Celebrado ✓', c: 'bg-ink text-white' },
  proximo: { t: 'Próximo', c: 'bg-white text-ink' },
  'por-llegar': { t: 'Por llegar', c: 'border border-current' },
};
const proximo = bloques.find((b) => est.get(b.slug) === 'proximo');
const celebrados = bloques.filter((b) => est.get(b.slug) === 'celebrado').length;
const tramos = Math.max(celebrados - 1, 0);
const fotos = bloques.flatMap((b) => b.fotos.map((f, i) => ({ ...f, label: `Bloque ${b.numero} · ${b.titulo}`, numero: b.numero, n: i + 1 })));
const rango = rangoMeses(bloques);
const intro = introPrograma(bloques);
const asociaciones = asociacionesDelPrograma(bloques);
---
<Base title="Start Skills" description={`Programa de liderazgo de Start UC3M: ${bloques.length} sábados con formadores profesionales y estudiantes de varias asociaciones. Consulta fechas, formadores y fotos.`} tone="dark">
  <section class="relative overflow-hidden bg-cobalt text-white">
    <!-- Una franja por bloque, con su color: el programa de un vistazo -->
    <div class="absolute inset-x-0 bottom-0 flex h-2.5" aria-hidden="true">{bloques.map((b) => <span class={`flex-1 ${b.numero === 5 ? 'bg-white' : tono(b.numero).bg}`}></span>)}</div>
    <div class="container-x relative flex flex-col gap-10 pb-14 pt-12 md:flex-row md:items-end md:justify-between md:gap-14 md:pb-20 md:pt-20">
      <div class="min-w-0 md:flex-1">
        <span class="eyebrow text-lavender">Programa de liderazgo · Curso {programa.curso}</span>
        <p class="marker mt-6 -rotate-2 text-[clamp(20px,2.2vw,30px)] text-lime">Lo que no se aprende en clase</p>
        <h1 class="display mt-2 text-[clamp(44px,10vw,128px)]" data-split>{programa.titulo}<span class="text-cyan">_</span></h1>
        <p class="mt-8 max-w-2xl text-xl text-lavender">{intro}</p>
      </div>
      <dl class="grid grid-cols-2 gap-3 md:w-80 md:shrink-0" data-reveal>
        <div class="rounded-brand bg-cyan p-4 text-ink"><dt class="mono text-[11px]">Sesiones</dt><dd class="display mt-2 text-[44px] leading-none">{bloques.length}</dd></div>
        {rango && <div class="rounded-brand bg-accent p-4 text-ink"><dt class="mono text-[11px]">De</dt><dd class="display mt-2 min-w-0 text-[clamp(28px,7vw,34px)] leading-none">{rango}</dd></div>}
        {asociaciones.length > 0 && <div class="col-span-2 rounded-brand bg-lime p-4 text-ink"><dt class="mono text-[11px]">Asociaciones</dt><dd class="display mt-2 text-[44px] leading-none">{asociaciones.length}</dd></div>}
      </dl>
    </div>
  </section>

  <section class="container-x pb-12 pt-14 md:pb-16 md:pt-24" aria-labelledby="bloques-titulo">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4 md:mb-10">
      <h2 id="bloques-titulo" class="display text-[clamp(40px,6vw,64px)] text-cobalt">Los {bloques.length} bloques<span class="text-ink">_</span></h2>
      <p class="mono text-ink/60">Un sábado al mes · pulsa un bloque para ver fotos y gente</p>
    </div>
    <div data-carrusel>
      <!-- Móvil: carrusel deslizable (se ve asomar la siguiente card). Escritorio: las 5 en fila. -->
      <ol class="-mx-4 -my-3 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 py-3 [scrollbar-width:none] md:-mx-8 md:scroll-px-8 md:px-8 lg:-mx-16 lg:scroll-px-16 lg:px-16 xl:mx-0 xl:grid xl:grid-cols-5 xl:gap-5 xl:overflow-visible xl:px-0 [&::-webkit-scrollbar]:hidden" data-pista data-stagger>
        {bloques.map((b) => {
          const e = est.get(b.slug)!;
          const t = tono(b.numero);
          return (
            <li class="flex w-[82%] shrink-0 snap-start sm:w-[45%] lg:w-[31%] xl:w-auto" data-card={b.slug} data-reveal>
              <a href={`/eventos/start-skills/${b.slug}`} data-actual={e === 'proximo' ? '' : undefined} class={`group relative flex min-h-[300px] min-w-0 flex-1 flex-col gap-3.5 overflow-hidden rounded-brand p-5 transition-transform duration-300 hover:-translate-y-1.5 hover:-rotate-1 md:min-h-[320px] ${t.bg} ${t.text} ${e === 'proximo' ? 'shadow-[6px_6px_0_var(--color-ink)] outline outline-2 outline-ink' : ''}`}>
                <span aria-hidden="true" class="display pointer-events-none absolute -bottom-6 -right-2 text-[150px] leading-none opacity-15 transition-transform duration-500 group-hover:scale-110">{b.numero}</span>
                <span class={`mono self-start rounded-full px-2 py-1 text-[11px] ${chip[e].c}`}>{chip[e].t}</span>
                <span class="display relative text-[34px] group-hover:underline">{b.titulo}</span>
                {b.tema && <span class="relative text-[15px] leading-snug">{b.tema}</span>}
                <span class={`relative mt-auto flex flex-col gap-0.5 border-t pt-3 ${b.numero === 5 ? 'border-white/30' : 'border-ink/20'}`}>
                  <span class="mono">{fechaCorta(b.fecha)}</span>
                  <span class="text-sm font-semibold">{b.formador?.nombre ?? 'Formador por anunciar'}</span>
                </span>
              </a>
            </li>
          );
        })}
      </ol>

      <!-- La numeración, debajo de las cards. En móvil cada número lleva a su card. -->
      <div class="relative mt-6 xl:mt-8">
        <div class="absolute left-[24px] right-[24px] top-[23px] h-0.5 bg-line xl:right-0" data-linea aria-hidden="true"></div>
        <!-- Progreso: del centro del 1 al centro del último celebrado. --k = tramos recorridos, --t = tramos totales.
             Todo en px a propósito (botones de 48 px, centro a 24 px; en escritorio xl:grid-cols-5 con gap de 20 px):
             con letra grande del navegador, los rem crecerían y la línea dejaría de pasar por los centros. -->
        <div class="absolute left-[24px] top-[22px] h-1 w-[calc((100%-48px)/var(--t)*var(--k))] bg-ink xl:w-[calc(((100%-80px)/5+20px)*var(--k))]" data-linea style={`--k:${tramos};--t:${Math.max(bloques.length - 1, 1)}`} aria-hidden="true"></div>
        <ol class="relative flex justify-between xl:grid xl:grid-cols-5 xl:gap-[20px]" aria-label="Ir a un bloque" data-numeros>
          {bloques.map((b, i) => {
            const e = est.get(b.slug)!;
            const t = tono(b.numero);
            return (
              <li>
                <button type="button" data-ir={i} aria-label={`Bloque ${b.numero}: ${b.titulo}`} class={`display grid h-[48px] w-[48px] place-items-center rounded-full border-2 border-ink text-[22px] ring-ink ring-offset-2 ring-offset-paper transition-shadow xl:pointer-events-none ${e === 'por-llegar' ? 'bg-white text-ink' : `${t.bg} ${t.text}`}`} data-estado={e}>{b.numero}</button>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  {proximo && (() => {
    const t = tono(proximo.numero);
    return (
      <section class={`${t.bg} ${t.text}`}>
        <div class="container-x flex flex-col gap-8 py-12 md:flex-row md:items-center md:justify-between md:py-16">
          <div class="flex min-w-0 items-center gap-6 md:gap-10">
            <span aria-hidden="true" class="display hidden text-[clamp(96px,12vw,180px)] leading-none md:block">{proximo.numero}</span>
            <div class="min-w-0">
              <span class="eyebrow">Próxima sesión · {fechaLarga(proximo.fecha)}</span>
              <p class="display mt-3 text-[clamp(36px,6vw,64px)]">Bloque {proximo.numero}: {proximo.titulo}</p>
              {proximo.formador && <p class="mt-2 text-[17px] font-semibold">Con {proximo.formador.nombre}</p>}
            </div>
          </div>
          <a href={`/eventos/start-skills/${proximo.slug}`} class="btn self-start bg-ink text-white">Ver el bloque <span class="font-mono">→</span></a>
        </div>
      </section>
    );
  })()}

  {fotos.length > 0 && (
    <section class="container-x py-14 md:py-24">
      <span class="eyebrow text-cobalt">Fotos de todos los bloques</span>
      <h2 class="display mt-2.5 text-[clamp(40px,6vw,64px)]">Galería</h2>
      <ul class="mt-8 grid grid-cols-2 gap-3 md:mt-10 md:grid-cols-4" data-stagger>
        {fotos.map((f) => (
          <li data-reveal>
            <a href={f.src} download class="group relative block aspect-[4/3] overflow-hidden rounded-brand bg-cobalt" aria-label={`Descargar foto ${String(f.n).padStart(2, '0')} de ${f.label}`}>
              <img src={f.thumb} srcset={f.small ? `${f.small} 400w, ${f.thumb} 800w` : undefined} sizes="(min-width: 768px) 25vw, 50vw" width={f.ancho} height={f.alto} alt={`Foto ${String(f.n).padStart(2, '0')} de ${f.label}`} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
              <span class={`mono absolute left-3 top-3 rounded-full px-2 py-1 text-[11px] ${tono(f.numero).bg} ${tono(f.numero).text}`}>{f.label}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm">Cada foto se descarga en alta resolución. También las tienes por bloque.</p>
    </section>
  )}
</Base>
<script>
  // Carrusel de bloques en móvil: los números de debajo llevan a su card y marcan la que se ve.
  const raiz = document.querySelector<HTMLElement>('[data-carrusel]');
  const pista = raiz?.querySelector<HTMLElement>('[data-pista]');
  const cards = [...(raiz?.querySelectorAll<HTMLElement>('[data-card]') ?? [])];
  const botones = [...(raiz?.querySelectorAll<HTMLButtonElement>('[data-ir]') ?? [])];
  const movil = matchMedia('(max-width: 1279px)');
  const suave = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

  const irA = (i: number, behavior: ScrollBehavior = suave) => {
    if (!pista || !cards[i] || !movil.matches) return;
    const delta = cards[i].getBoundingClientRect().left - pista.getBoundingClientRect().left;
    pista.scrollTo({ left: pista.scrollLeft + delta - (parseFloat(getComputedStyle(pista).scrollPaddingLeft) || 0), behavior });
  };
  const marcar = (i: number) =>
    botones.forEach((b, j) => {
      const on = movil.matches && i === j;
      b.classList.toggle('ring-2', on);
      if (on) b.setAttribute('aria-current', 'true');
      else b.removeAttribute('aria-current');
    });

  // En escritorio los números son solo indicador: fuera del orden de tabulación.
  const numeros = raiz?.querySelector('[data-numeros]');
  const tabulables = () => {
    botones.forEach((b) => (b.tabIndex = movil.matches ? 0 : -1));
    numeros?.toggleAttribute('aria-hidden', !movil.matches);
  };
  tabulables();
  botones.forEach((b, i) => b.addEventListener('click', () => irA(i)));

  // La card más visible manda.
  const visibles = new Map<Element, number>();
  const io = new IntersectionObserver(
    (entradas) => {
      entradas.forEach((e) => visibles.set(e.target, e.intersectionRatio));
      let mejor = 0;
      cards.forEach((c, i) => { if ((visibles.get(c) ?? 0) > (visibles.get(cards[mejor]) ?? 0)) mejor = i; });
      marcar(mejor);
    },
    { root: pista, threshold: [0.25, 0.5, 0.75, 1] },
  );
  cards.forEach((c) => io.observe(c));

  // En móvil empieza en el bloque actual (el próximo), ya marcado abajo; si ya se celebraron todos, en el último.
  const actual = cards.findIndex((c) => c.querySelector('[data-actual]'));
  const inicio = actual >= 0 ? actual : cards.length - 1;
  irA(inicio, 'auto');
  marcar(inicio);
  movil.addEventListener('change', () => { tabulables(); irA(inicio, 'auto'); marcar(movil.matches ? inicio : -1); });
</script>
