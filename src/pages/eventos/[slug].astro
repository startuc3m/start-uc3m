---
import Photo from '../../components/Photo.astro';
import Doodle from '../../components/Doodle.astro';
import { eventoFotos } from '../../lib/fotos';
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { eventos, eventEnd } from '../../lib/content';
import { eventToIcs, icsDataHref, eventStartDate, hasClockTime } from '../../lib/ics';
import { site } from '../../lib/site';
export async function getStaticPaths() {
  return (await eventos()).map((e) => ({ params: { slug: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content } = await render(e);
const fotos = eventoFotos[e.id];
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
const lastDay = new Date(e.data.date.getTime() + (e.data.days - 1) * 86400000);
const fmtDay = (d: Date) => d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric' });
const dateLabel = e.data.days > 1 ? `${fmtDay(e.data.date)} y ${fmt(lastDay).replace(',', '')}` : fmt(e.data.date);
const timeLabel = e.data.endTime ? (e.data.days > 1 ? `${e.data.time} (${fmtDay(e.data.date).split(' ')[0]}) – ${e.data.endTime} (${fmtDay(lastDay).split(' ')[0]})` : `${e.data.time} – ${e.data.endTime}`) : e.data.time;
const { prizes, mentors, jury, info } = e.data;
const initials = (n: string) => n.split(' ').filter((w) => w.length > 2).slice(0, 2).map((w) => w[0]).join('');
const open = e.data.status === 'abierto';
// Cuenta atrás en vivo solo para el Camp (misma fecha que el banner y el lanyard).
const countdown = e.id === 'start-camp' && open;
const soldOut = e.data.status === 'sold-out';
const past = e.data.status === 'pasado';
// Plataforma de inscripción según el dominio de `external` (Luma, Neonpass…).
const platform = e.data.external?.includes('neonpass') ? 'Neonpass' : 'Luma';
const sponsorLogos = e.data.sponsors.map((n) => site.sponsors.find((s) => s.name.toLowerCase() === n.toLowerCase()) ?? { name: n });
const icsHref = icsDataHref(eventToIcs({ title: e.data.title, description: e.data.subtitle, location: e.data.place, date: e.data.date, time: e.data.time, days: e.data.days }));
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.data.title,
  description: e.data.subtitle,
  startDate: hasClockTime(e.data.time) ? eventStartDate(e.data.date, e.data.time).toISOString() : e.data.date.toISOString().slice(0, 10),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  endDate: new Date(eventEnd(e.data.date, e.data.days) - 1).toISOString().slice(0, 10),
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: e.data.place, address: e.data.place },
  organizer: { '@type': 'Organization', name: 'Start UC3M', url: 'https://www.startuc3m.es' },
};
---
<Base title={e.data.title} description={e.data.subtitle} tone="dark">
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <!-- HERO: imagen del evento a sangre fundida con cobalto -->
  <section class="relative overflow-hidden bg-cobalt text-white">
    <Photo name={fotos?.hero} eager class="absolute inset-0 h-full w-full object-cover opacity-70 mix-blend-luminosity" />
    <div class="absolute inset-0 bg-gradient-to-b from-cobalt/30 via-cobalt/65 to-cobalt"></div>
    <div class="container-x relative grid min-h-[80vh] gap-8 md:gap-12 pb-10 md:pb-16 pt-14 md:pt-24 md:grid-cols-[1.4fr_1fr] md:items-end">
      <div>
        <span class="eyebrow text-lavender">{e.data.type}{e.data.edition && ` · ${e.data.edition}`}</span>
        <h1 class="display mt-4 text-[clamp(44px,8vw,120px)]" data-split>{e.data.title}</h1>
        <p class="mt-6 max-w-xl text-2xl text-lavender">{e.data.subtitle}</p>
        <ul class="mt-8 flex flex-wrap gap-2">{e.data.tags.map((t) => <li class="mono rounded-full border border-white/40 px-3 py-2">{t}</li>)}</ul>
      </div>
      <div class="flex flex-col gap-5" data-reveal>
      <dl class="flex flex-col gap-5 rounded-brand border border-white/20 bg-cobalt/50 p-6 backdrop-blur md:text-right">
        {countdown && <div hidden data-camp-countdown><dt class="eyebrow text-lavender/70">Empieza en</dt><dd class="font-mono text-3xl font-medium tabular-nums text-lime" role="timer" data-camp-countdown-clock></dd></div>}
        <div><dt class="eyebrow text-lavender/70">Fecha</dt><dd class="text-2xl font-semibold first-letter:uppercase">{dateLabel}</dd><dd class="mt-1 text-lavender">{timeLabel}</dd></div>
        <div><dt class="eyebrow text-lavender/70">Lugar</dt><dd class="text-2xl font-semibold">{e.data.place}</dd></div>
        {e.data.price && <div><dt class="eyebrow text-lavender/70">Entrada</dt><dd class="text-2xl font-semibold">{e.data.price}</dd>{e.data.priceNote && <dd class="mt-1 text-lavender">{e.data.priceNote}</dd>}</div>}
        {(past || soldOut || e.data.seats) && <div><dt class="eyebrow text-lavender/70">Plazas</dt><dd class="text-2xl font-semibold">{past ? 'Evento celebrado' : soldOut ? 'Sold out' : e.data.seats}</dd></div>}
      </dl>
      <div class="flex flex-wrap gap-3 md:justify-end">
          {open && (e.data.external
            ? <a href={e.data.external} target="_blank" rel="noopener" class="btn btn-lime">Reservar plaza <span class="font-mono">↗</span></a>
            : <a href="#inscripcion" class="btn btn-on-blue">Inscripción <span class="font-mono">→</span></a>)}
          {!past && <a href={icsHref} download={`${e.id}.ics`} class="btn btn-outline text-white">Añadir al calendario <span class="font-mono">＋</span></a>}
          {past && <a href="/eventos" class="btn btn-outline text-white">Ver próximos eventos</a>}
      </div>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHTS -->
  {(e.data.highlights ?? []).length > 0 && (
    <section class="border-b border-line bg-paper">
      <div class="container-x grid gap-6 py-10 sm:grid-cols-3" data-stagger>
        {(e.data.highlights ?? []).map((h, i) => (
          <div class="border-l-2 border-cobalt pl-4" data-reveal><span class="mono text-cobalt">0{i + 1}</span><p class="mt-1 text-2xl font-bold">{h}</p></div>
        ))}
      </div>
    </section>
  )}

  <section class="container-x grid gap-10 md:gap-16 py-12 md:py-20 md:grid-cols-[1fr_1.2fr]">
    <div data-reveal>
      <span class="eyebrow text-cobalt">El evento</span>
      <div class="prose prose-lg mt-4 max-w-none text-ink prose-headings:font-bold prose-a:text-cobalt"><Content /></div>
      {sponsorLogos.length > 0 && (
        <div class="mt-10">
          <span class="eyebrow text-cobalt">Con el apoyo de</span>
          <ul class="mt-4 flex flex-wrap items-center gap-4">
            {sponsorLogos.map((s) => (
              <li class="grid h-16 min-w-[120px] place-items-center rounded-brand bg-paper-2 px-5">
                {'logo' in s && s.logo ? <img src={s.logo} alt={s.name} class="max-h-9 w-auto object-contain" loading="lazy" /> : <span class="text-lg font-bold uppercase tracking-wider text-cobalt">{s.name}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
    {e.data.agenda.length > 0 ? (
      <div data-reveal>
        <span class="eyebrow text-cobalt">Agenda</span>
        <ol class="relative mt-4 border-l-2 border-cobalt/30 pl-8" data-stagger>
          {e.data.agenda.map((a) => (
            <li class="relative pb-10 last:pb-0" data-reveal>
              <span class="absolute -left-[41px] top-1.5 h-4 w-4 rounded-full border-4 border-paper bg-cobalt"></span>
              <span class="mono text-cobalt">{a.time}</span>
              <h3 class="mt-1 text-2xl font-bold">{a.title}</h3>
              <p class="mt-1 opacity-70">{a.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    ) : (
      <div class="relative aspect-[4/3] overflow-hidden rounded-brand" data-reveal><Photo name={fotos?.side} sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0 h-[120%] w-full object-cover" /></div>
    )}
  </section>
  <!-- PREMIOS: los que no están confirmados salen como "por anunciar" -->
  {prizes.length > 0 && (
    <section class="border-t border-line bg-paper">
      <div class="container-x py-12 md:py-20">
        <div class="flex items-end justify-between gap-6" data-reveal>
          <div>
            <span class="eyebrow text-cobalt">Qué te llevas</span>
            <h2 class="display mt-3 text-[clamp(32px,5vw,64px)] text-cobalt">Premios_</h2>
          </div>
          <Doodle name="star" class="hidden h-16 w-16 md:block" />
        </div>
        <ol class="mt-8 grid gap-4 md:grid-cols-[1.6fr_1fr_1fr]" data-stagger>
          {prizes.map((p, i) => (
            <li class={`flex min-h-[200px] flex-col justify-between gap-6 rounded-brand p-6 md:p-8 ${p.prize ? 'bg-lime text-ink' : 'border-2 border-dashed border-cobalt/30 text-cobalt'}`} data-reveal>
              <span class="mono">{p.place}</span>
              {p.prize ? (
                <div>
                  <p class={`font-bold leading-tight ${i === 0 ? 'text-[clamp(28px,3.4vw,44px)]' : 'text-2xl'}`}>{p.prize}</p>
                  {p.note && <p class="mt-2 text-lg">{p.note}</p>}
                </div>
              ) : (
                <p class="text-2xl font-bold opacity-60">Por anunciar</p>
              )}
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- INFO PRÁCTICA: cómo llegar, horario, equipo… (solo lo confirmado) -->
  {info.length > 0 && (
    <section class="border-t border-line bg-paper-2">
      <div class="container-x py-12 md:py-20">
        <div data-reveal>
          <span class="eyebrow text-cobalt">Antes de ir</span>
          <h2 class="display mt-3 text-[clamp(32px,5vw,64px)] text-cobalt">Info práctica_</h2>
        </div>
        <ul class="mt-8 grid gap-4 md:grid-cols-3" data-stagger>
          {info.map((it, i) => (
            <li class="flex flex-col gap-3 rounded-brand bg-paper p-6 md:p-8" data-reveal>
              <span class="mono text-cobalt">0{i + 1}</span>
              <h3 class="text-2xl font-bold">{it.title}</h3>
              <p class="text-lg opacity-80">{it.text}</p>
              {it.link && <a href={it.link.href} target="_blank" rel="noopener" class="mt-auto pt-2 font-semibold text-cobalt underline underline-offset-4">{it.link.label} <span class="font-mono">↗</span></a>}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- MENTORES Y JURADO: nombres confirmados + huecos por confirmar hasta el total previsto -->
  {(mentors || jury) && (
    <section class="bg-cobalt text-white">
      <div class="container-x grid gap-12 py-12 md:grid-cols-[1.4fr_1fr] md:gap-16 md:py-20">
        {mentors && (
          <div data-reveal>
            <span class="eyebrow text-lavender">Te acompañan</span>
            <h2 class="display mt-3 text-[clamp(32px,5vw,64px)]">{mentors.total} mentores_</h2>
            <p class="mt-4 max-w-md text-lavender">Acompañan a los equipos durante los dos días para ayudarte a aterrizar la idea.</p>
            <ul class="mt-8 grid gap-3 sm:grid-cols-2" data-stagger>
              {mentors.names.map((n) => (
                <li class="flex items-center gap-4 rounded-brand bg-white/10 p-3 pr-5" data-reveal>
                  <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-lime font-mono font-semibold text-ink" aria-hidden="true">{initials(n)}</span>
                  <span class="text-lg font-semibold leading-tight">{n}</span>
                </li>
              ))}
              {mentors.total > mentors.names.length && (
                <li class="flex items-center gap-4 rounded-brand border-2 border-dashed border-white/30 p-3 pr-5" data-reveal>
                  <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full border-2 border-dashed border-white/40 font-mono" aria-hidden="true">+{mentors.total - mentors.names.length}</span>
                  <span class="text-lg leading-tight text-lavender">Más mentores muy pronto</span>
                </li>
              )}
            </ul>
          </div>
        )}
        {jury && (
          <div data-reveal>
            <span class="eyebrow text-lavender">La final</span>
            <h2 class="display mt-3 text-[clamp(32px,5vw,64px)]">{jury.total} jurados_</h2>
            <p class="mt-4 max-w-md text-lavender">Escuchan los pitch de la final y eligen a los ganadores.{jury.names.length < jury.total && ' Desvelamos los nombres muy pronto.'}</p>
            <ul class="mt-8 flex flex-wrap gap-3" aria-label={`${jury.total} jurados`}>
              {Array.from({ length: jury.total }, (_, i) => jury.names[i]).map((n) => n
                ? <li class="rounded-full bg-white/10 px-4 py-2 font-semibold">{n}</li>
                : <li class="h-14 w-14 rounded-full border-2 border-dashed border-white/40" aria-hidden="true"></li>)}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- GALERÍA: fotos reales del evento (#64), en mosaico -->
  {fotos?.gallery && fotos.gallery.length > 0 && (
    <section class="bg-paper-2">
      <div class="container-x py-12 md:py-20">
        <div class="flex items-end justify-between gap-6" data-reveal>
          <h2 class="display text-[clamp(32px,5vw,64px)] text-cobalt">{fotos.galleryTitle ?? 'Así fue'}_</h2>
          <Doodle name="burst" class="hidden h-14 w-14 text-cobalt md:block" />
        </div>
        <ul class="mt-8 grid auto-rows-[160px] grid-cols-2 gap-3 md:auto-rows-[220px] md:grid-cols-4" data-stagger>
          {fotos.gallery.map((g, i) => (
            <li class={`relative overflow-hidden rounded-brand ${i % 5 === 0 ? 'col-span-2 row-span-2' : ''}`}>
              <Photo name={g} sizes={i % 5 === 0 ? '(min-width: 768px) 50vw, 100vw' : '(min-width: 768px) 25vw, 50vw'} class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 hover:scale-105" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}
  {open ? (
    <section id="inscripcion" class="bg-navy text-white">
      <div class="container-x flex flex-col gap-6 py-12 md:py-20 md:flex-row md:items-end md:justify-between" data-reveal>
        <div>
          <span class="eyebrow text-lavender">Inscripción</span>
          <h2 class="display mt-3 text-[clamp(32px,5vw,64px)]">Reserva tu plaza_</h2>
          <p class="mt-4 max-w-xl text-lavender">{e.data.external ? platform === 'Luma' ? 'La inscripción se hace en Luma. Si no tienes equipo, te lo montamos allí.' : `Las entradas se venden en ${platform}.` : 'Abrimos la inscripción muy pronto. Síguenos en Instagram para enterarte.'}</p>
        </div>
        {e.data.external
          ? <a href={e.data.external} target="_blank" rel="noopener" class="btn btn-lime">{platform === 'Luma' ? 'Inscribirme en Luma' : `Comprar entrada en ${platform}`} <span class="font-mono">↗</span></a>
          : <a href={site.social.instagram} target="_blank" rel="noopener" class="btn btn-outline text-white">Instagram de Start <span class="font-mono">↗</span></a>}
      </div>
    </section>
  ) : soldOut ? (
    <section id="inscripcion" class="bg-navy text-white">
      <div class="container-x py-12 md:py-20" data-reveal>
        <span class="eyebrow text-lavender">Sold out</span>
        <h2 class="display mt-3 text-[clamp(32px,5vw,64px)]">Plazas completas_</h2>
        <p class="mt-4 max-w-xl text-lavender">Si se libera alguna plaza lo anunciaremos en nuestras redes.</p>
      </div>
    </section>
  ) : (
    <section class="bg-navy text-white">
      <div class="container-x flex flex-col gap-6 py-10 md:py-16 md:flex-row md:items-end md:justify-between" data-reveal>
        <div><span class="eyebrow text-lavender">Evento celebrado</span><h2 class="display mt-3 text-[clamp(28px,4vw,56px)]">¿Te lo perdiste? El próximo, no_</h2></div>
        <div class="flex gap-3"><a href="/eventos" class="btn btn-on-blue">Próximos eventos <span class="font-mono">→</span></a><a href="/unete" class="btn btn-outline text-white">Entrar en Start</a></div>
      </div>
    </section>
  )}
</Base>
<script>
  import { STARTCAMP_END, getStartcampCountdown } from '../../components/lanyard/startcamp_countdown.js';
  const box = document.querySelector<HTMLElement>('[data-camp-countdown]');
  if (box && Date.now() < STARTCAMP_END) {
    box.hidden = false;
    const clock = box.querySelector<HTMLElement>('[data-camp-countdown-clock]')!;
    const pad = (n: number) => String(n).padStart(2, '0');
    const tick = () => {
      const [d, h, m, s] = getStartcampCountdown();
      clock.textContent = d + h + m + s > 0 ? `${d}d ${pad(h)}h ${pad(m)}m ${pad(s)}s` : '¡Ya ha empezado!';
    };
    tick();
    setInterval(tick, 1000);
  }
</script>
