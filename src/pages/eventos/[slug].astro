---
import Placeholder from '../../components/Placeholder.astro';
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { eventToIcs, icsDataHref, eventStartDate } from '../../lib/ics';
import { site } from '../../lib/site';
import { asset } from '../../lib/url';
export async function getStaticPaths() {
  return (await getCollection('eventos')).map((e) => ({ params: { slug: e.id }, props: { e } }));
}
const { e } = Astro.props;
const { Content } = await render(e);
const fmt = (d: Date) => d.toLocaleDateString('es-ES', { weekday: 'long', day: 'numeric', month: 'long' });
const open = e.data.status === 'abierto';
const soldOut = e.data.status === 'sold-out';
const past = e.data.status === 'pasado';
const sponsorLogos = e.data.sponsors.map((n) => site.sponsors.find((s) => s.name.toLowerCase() === n.toLowerCase()) ?? { name: n });
const icsHref = icsDataHref(eventToIcs({ title: e.data.title, description: e.data.subtitle, location: e.data.place, date: e.data.date, time: e.data.time }));
const eventJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: e.data.title,
  description: e.data.subtitle,
  startDate: eventStartDate(e.data.date, e.data.time).toISOString(),
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: { '@type': 'Place', name: e.data.place, address: e.data.place },
  organizer: { '@type': 'Organization', name: 'Start UC3M', url: 'https://www.startuc3m.es' },
};
---
<Base title={e.data.title} description={e.data.subtitle} tone="dark">
  <script type="application/ld+json" set:html={JSON.stringify(eventJsonLd)} />
  <!-- HERO: imagen del evento a sangre fundida con cobalto -->
  <section class="relative overflow-hidden bg-cobalt text-white">
    <Placeholder class="absolute inset-0 h-full w-full object-cover opacity-70 mix-blend-luminosity" />
    <div class="absolute inset-0 bg-gradient-to-b from-cobalt/30 via-cobalt/65 to-cobalt"></div>
    <div class="container-x relative grid min-h-[80vh] gap-12 pb-16 pt-24 md:grid-cols-[1.4fr_1fr] md:items-end">
      <div>
        <span class="eyebrow text-lavender">{e.data.type}{e.data.edition && ` · ${e.data.edition}`}</span>
        <h1 class="display mt-4 text-[clamp(44px,8vw,120px)]" data-split>{e.data.title}</h1>
        <p class="mt-6 max-w-xl text-2xl text-lavender">{e.data.subtitle}</p>
        <ul class="mt-8 flex flex-wrap gap-2">{e.data.tags.map((t) => <li class="mono rounded-full border border-white/40 px-3 py-2">{t}</li>)}</ul>
      </div>
      <dl class="flex flex-col gap-5 rounded-brand border border-white/20 bg-cobalt/50 p-6 backdrop-blur md:text-right" data-reveal>
        <div><dt class="eyebrow text-lavender/70">Fecha</dt><dd class="text-2xl font-semibold capitalize">{fmt(e.data.date)} · {e.data.time}</dd></div>
        <div><dt class="eyebrow text-lavender/70">Lugar</dt><dd class="text-2xl font-semibold">{e.data.place}</dd></div>
        <div><dt class="eyebrow text-lavender/70">Plazas</dt><dd class="text-2xl font-semibold">{past ? 'Evento celebrado' : soldOut ? 'Sold out' : e.data.seats ? `${e.data.seats}` : 'Limitadas'}</dd></div>
        <div class="flex flex-wrap gap-3 md:justify-end">
          {open && <a href="#inscripcion" class="btn btn-on-blue">Reservar plaza <span class="font-mono">→</span></a>}
          {soldOut && <a href="#lista-espera" class="btn btn-on-blue">Lista de espera <span class="font-mono">→</span></a>}
          {!past && <a href={icsHref} download={`${e.id}.ics`} class="btn btn-outline text-white">Añadir al calendario <span class="font-mono">＋</span></a>}
          {past && <a href="/eventos" class="btn btn-outline text-white">Ver próximos eventos</a>}
        </div>
      </dl>
    </div>
  </section>

  <!-- HIGHLIGHTS -->
  {(e.data.highlights ?? []).length > 0 && (
    <section class="border-b border-line bg-paper">
      <div class="container-x grid gap-6 py-10 sm:grid-cols-3" data-stagger>
        {(e.data.highlights ?? []).map((h, i) => (
          <div class="border-l-2 border-cobalt pl-4" data-reveal><span class="mono text-cobalt">0{i + 1}</span><p class="mt-1 text-2xl font-bold">{h}</p></div>
        ))}
      </div>
    </section>
  )}

  <section class="container-x grid gap-16 py-20 md:grid-cols-[1fr_1.2fr]">
    <div data-reveal>
      <span class="eyebrow text-cobalt">El evento</span>
      <div class="prose prose-lg mt-4 max-w-none text-ink prose-headings:font-bold prose-a:text-cobalt"><Content /></div>
      {sponsorLogos.length > 0 && (
        <div class="mt-10">
          <span class="eyebrow text-cobalt">Con el apoyo de</span>
          <ul class="mt-4 flex flex-wrap items-center gap-4">
            {sponsorLogos.map((s) => (
              <li class="grid h-16 min-w-[120px] place-items-center rounded-brand bg-paper-2 px-5">
                {'logo' in s && s.logo ? <img src={asset(s.logo)} alt={s.name} class="max-h-9 w-auto object-contain" loading="lazy" /> : <span class="text-lg font-bold uppercase tracking-wider text-cobalt">{s.name}</span>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
    {e.data.agenda.length > 0 ? (
      <div data-reveal>
        <span class="eyebrow text-cobalt">Agenda</span>
        <ol class="relative mt-4 border-l-2 border-cobalt/30 pl-8" data-stagger>
          {e.data.agenda.map((a) => (
            <li class="relative pb-10 last:pb-0" data-reveal>
              <span class="absolute -left-[41px] top-1.5 h-4 w-4 rounded-full border-4 border-paper bg-cobalt"></span>
              <span class="mono text-cobalt">{a.time}</span>
              <h3 class="mt-1 text-2xl font-bold">{a.title}</h3>
              <p class="mt-1 opacity-70">{a.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    ) : (
      <div class="relative aspect-[4/3] overflow-hidden rounded-brand" data-reveal><Placeholder class="absolute inset-0 h-[120%] w-full object-cover" /></div>
    )}
  </section>
  {open ? (
    <section id="inscripcion" class="bg-navy text-white">
      <div class="container-x flex flex-col gap-6 py-20 md:flex-row md:items-end md:justify-between" data-reveal>
        <div>
          <span class="eyebrow text-lavender">Inscripción</span>
          <h2 class="display mt-3 text-[clamp(32px,5vw,64px)]">Reserva tu plaza_</h2>
          <p class="mt-4 max-w-xl text-lavender">{e.data.external ? 'La inscripción se hace en Luma. Si no tienes equipo, te lo montamos allí.' : 'Abrimos la inscripción muy pronto. Síguenos en Instagram para enterarte.'}</p>
        </div>
        {e.data.external
          ? <a href={e.data.external} target="_blank" rel="noopener" class="btn btn-on-blue">Inscribirme en Luma <span class="font-mono">↗</span></a>
          : <a href={site.social.instagram} target="_blank" rel="noopener" class="btn btn-outline text-white">Instagram de Start <span class="font-mono">↗</span></a>}
      </div>
    </section>
  ) : soldOut ? (
    <section id="inscripcion" class="bg-navy text-white">
      <div class="container-x py-20" data-reveal>
        <span class="eyebrow text-lavender">Sold out</span>
        <h2 class="display mt-3 text-[clamp(32px,5vw,64px)]">Plazas completas_</h2>
        <p class="mt-4 max-w-xl text-lavender">Si se libera alguna plaza lo anunciaremos en nuestras redes.</p>
      </div>
    </section>
  ) : (
    <section class="bg-navy text-white">
      <div class="container-x flex flex-col gap-6 py-16 md:flex-row md:items-end md:justify-between" data-reveal>
        <div><span class="eyebrow text-lavender">Evento celebrado</span><h2 class="display mt-3 text-[clamp(28px,4vw,56px)]">¿Te lo perdiste? El próximo, no_</h2></div>
        <div class="flex gap-3"><a href="/eventos" class="btn btn-on-blue">Próximos eventos <span class="font-mono">→</span></a><a href="/unete" class="btn btn-outline text-white">Entrar en Start</a></div>
      </div>
    </section>
  )}
</Base>
