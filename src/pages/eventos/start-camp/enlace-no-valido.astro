---
import Photo from '../../../components/Photo.astro';
import Base from '../../../layouts/Base.astro';
import Logo from '../../../components/Logo.astro';
// Destino del formulario del avatar cuando falta el token o el back lo rechaza.
// Misma estructura que la 404.
---
<Base title="Enlace no válido" tone="dark" noindex>
  <section class="relative overflow-hidden bg-cobalt text-white">
    <Photo class="absolute inset-0 h-full w-full object-cover opacity-30 mix-blend-luminosity" name="descanso" position="center 85%" eager />
    <div class="absolute inset-0 bg-gradient-to-b from-cobalt/40 to-cobalt"></div>
    <div class="container-x relative flex min-h-[80vh] flex-col justify-center py-12 md:py-20">
      <Logo tone="white" size={40} />
      <span class="eyebrow mt-12 text-lavender">Enlace no válido</span>
      <h1 class="display mt-4 text-[clamp(56px,12vw,180px)]" data-split>¿Te has perdido?_</h1>
      <p class="mt-6 max-w-md text-xl text-lavender" data-reveal>Este enlace ha caducado o no es correcto. Esta es nuestra web; creemos que querías ir aquí:</p>
      <div class="mt-8 flex flex-wrap gap-3" data-reveal>
        <a href="/" class="btn btn-on-blue">Ir a startuc3m.es <span class="font-mono">→</span></a>
        <a href="/eventos/start-camp" class="btn btn-outline text-white">Volver al Start Camp</a>
      </div>
    </div>
  </section>
</Base>
