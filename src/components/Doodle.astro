---
// Garabatos del brand kit ("acompañar texto"): estrella, flecha, subrayado y estallido.
// Trazos a mano en SVG, decorativos (aria-hidden). El color sale de `currentColor`
// salvo la estrella, que va rellena en amarillo como en la portada del kit.
interface Props { name: 'star' | 'arrow' | 'underline' | 'burst'; class?: string }
const { name, class: cls = '' } = Astro.props;
---
{name === 'star' && (
  <svg class={cls} viewBox="0 0 100 96" aria-hidden="true">
    <path d="M51 4 C55 20 59 31 63 36 C74 37 86 36 97 37 C88 46 79 53 72 58 C75 71 79 82 82 93 C71 86 61 79 52 73 C42 80 31 87 19 93 C24 81 28 70 31 59 C21 52 12 45 3 37 C16 37 28 37 39 36 C43 25 47 14 51 4 Z" fill="var(--color-accent)" stroke="#12123a" stroke-width="3" stroke-linejoin="round" />
    <path d="M44 30 C47 34 52 35 57 34" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".7" />
  </svg>
)}
{name === 'arrow' && (
  <svg class={cls} viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M14 10 C60 6 104 34 96 92" />
    <path d="M78 76 C84 84 90 90 96 96 C100 86 104 78 110 70" />
  </svg>
)}
{name === 'underline' && (
  <svg class={cls} viewBox="0 0 300 24" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" preserveAspectRatio="none" aria-hidden="true">
    <path d="M4 14 C60 6 130 4 296 10" />
    <path d="M30 20 C110 12 190 12 270 16" stroke-width="4" opacity=".8" />
  </svg>
)}
{name === 'burst' && (
  <svg class={cls} viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" aria-hidden="true">
    <path d="M14 46 L4 30" />
    <path d="M34 34 L30 6" />
    <path d="M52 40 L66 16" />
  </svg>
)}
