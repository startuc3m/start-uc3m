---
// Formulario genérico: hace POST a /api/forms y guarda en data/submissions.json
const { name, fields, submit = 'Enviar', dark = false } = Astro.props as {
  name: string; submit?: string; dark?: boolean;
  fields: { name: string; label: string; type?: string; required?: boolean; options?: string[]; placeholder?: string; full?: boolean }[];
};
const input = `w-full rounded-brand border px-4 py-3 text-base outline-none focus:ring-2 ${dark ? 'border-white/40 bg-transparent text-white placeholder:text-lavender/60 focus:ring-white' : 'border-line bg-white text-ink focus:ring-cobalt'}`;
---
<form data-form={name} action="/api/forms" method="post" class="grid gap-5 md:grid-cols-2" novalidate>
  <input type="hidden" name="form" value={name} />
  <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  {fields.map((f) => (
    <label class={`flex flex-col gap-2 ${f.full ? 'md:col-span-2' : ''}`}>
      <span class="mono">{f.label}{f.required && ' *'}</span>
      {f.type === 'textarea' ? (
        <textarea name={f.name} required={f.required} rows="5" placeholder={f.placeholder} class={input}></textarea>
      ) : f.type === 'select' ? (
        <select name={f.name} required={f.required} class={input}>{f.options!.map((o) => <option>{o}</option>)}</select>
      ) : (
        <input type={f.type ?? 'text'} name={f.name} required={f.required} placeholder={f.placeholder} class={input} />
      )}
    </label>
  ))}
  <label class="flex items-start gap-3 text-sm md:col-span-2"><input type="checkbox" name="rgpd" required class="mt-1" /><span>Acepto que Start UC3M trate mis datos para gestionar esta solicitud. No los cedemos a terceros.</span></label>
  <div class="md:col-span-2 flex items-center gap-4">
    <button class={`btn ${dark ? 'btn-on-blue' : 'btn-primary'}`}>{submit} <span class="font-mono">→</span></button>
    <p data-form-status class="text-sm font-semibold" aria-live="polite"></p>
  </div>
</form>
<script>
  // Envío sin recarga; funciona en `astro dev` y en `node dist/server/entry.mjs`.
  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-form-status]')!;
      if (!form.reportValidity()) return;
      status.textContent = 'Enviando…';
      try {
        const r = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const j = await r.json();
        status.textContent = r.ok ? '¡Recibido! Te escribimos pronto.' : j.error ?? 'Algo ha fallado.';
        if (r.ok) form.reset();
      } catch { status.textContent = 'Sin conexión con el servidor. Inténtalo de nuevo.'; }
    });
  });
</script>
