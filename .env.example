# Supabase del perfil del Start Camp. Son públicas (PUBLIC_: Astro las mete
# en el código del navegador). Nunca pongas aquí la secret / service_role.
PUBLIC_SUPABASE_URL=https://rufoyhnfrviquwcomoht.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NOTION_API_KEY=
# Start Skills: token de su integración de Notion (opcional; si falta se usa NOTION_API_KEY).
# NOTION_STARTSKILLS_API_KEY=
# Start Skills: id de la base de datos "Bloques" en Notion (ver docs/12-start-skills.md).
# NOTION_STARTSKILLS_DATABASE_ID=
# Start Skills: id de la base "Participantes" (opcional; solo si es una base aparte).
# NOTION_STARTSKILLS_PARTICIPANTES_DATABASE_ID=

# Panel independiente: usar un proyecto de pruebas, nunca las credenciales del Start Camp.
# Activar ambas banderas solo cuando la migración y configuración estén verificadas.
PUBLIC_PANEL_ENABLED=false
PUBLIC_PANEL_SUPABASE_URL=
PUBLIC_PANEL_SUPABASE_KEY=
PANEL_ENABLED=false
PANEL_SUPABASE_URL=
PANEL_SUPABASE_SECRET_KEY=
PANEL_SITE_URL=http://localhost:4321
# Mantener false en previews. Ninguna variable de esta sección es PUBLIC_.
PANEL_SEND_EMAILS=false
PANEL_RESEND_API_KEY=
PANEL_EMAIL_FROM=
PANEL_REPLY_TO=
# 32 bytes aleatorios codificados como 64 caracteres hexadecimales; no reutilizar claves.
PANEL_MAIL_ENCRYPTION_KEY=
